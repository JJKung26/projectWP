<%# เลือกชื่อหัวข้อและป้ายตามคอลัมน์รอทำหรือกำลังทำ %>
<%
  const heading = isCooking ? 'กำลังทำ' : 'รอคิว';
  const badgeClass = isCooking ? 'badge-pill-preparing' : 'badge-pill-waiting';
  const badgeLabel = isCooking ? 'PREPARING' : 'WAITING';
%>
<div class="kitchen-col-card">
  <%# หัวคอลัมน์และจำนวนรอบอาหาร %>
  <div class="kitchen-col-header row between">
    <h2><%= heading %></h2>
    <span class="<%= badgeClass %>"><%= badgeLabel %> (<%= rounds.length %>)</span>
  </div>
  <%# แสดงการ์ดออเดอร์ในคอลัมน์ หรือข้อความเมื่อไม่มีรายการ %>
  <% if (rounds.length === 0) { %>
    <div class="text-center empty" style="padding: 40px 10px;">
      <p class="muted">ไม่มีรายการ<%= heading %></p>
    </div>
  <% } else { %>
    <div class="round-card-list column">
      <% for (const round of rounds) { %>
        <%-
          include('../../partials/staff-order-card', {
            round,
            mode: isCooking ? 'cooking' : 'waiting'
          })
        %>
      <% } %>
    </div>
  <% } %>
</div>
