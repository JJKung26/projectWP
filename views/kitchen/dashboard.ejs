<%- include('../partials/header') %>
<%
    // SQLite CURRENT_TIMESTAMP is UTC without a zone marker
    const toTime = s => new Date(String(s).replace(' ', 'T') + 'Z')
        .toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Bangkok' });
    const pending = orderItems.filter(i => i.item_status === 'PENDING').length;
    const cooking = orderItems.filter(i => i.item_status === 'COOKING').length;
    const soldOut = menuItems.filter(m => m.availability === 0).length;
%>

<div class="container">
    <div class="page-head">
        <div>
            <div class="eyebrow">ครัว</div>
            <h1>คิวออเดอร์</h1>
            <p>เรียงตามเวลาสั่ง รายการเก่าสุดอยู่ก่อน</p>
        </div>
        <div class="stat-strip">
            <div class="stat">
                <div class="stat-label"><span class="dot warn"></span>รอทำ</div>
                <div class="stat-value"><%= pending %></div>
            </div>
            <div class="stat">
                <div class="stat-label"><span class="dot" style="background: var(--info);"></span>กำลังทำ</div>
                <div class="stat-value"><%= cooking %></div>
            </div>
        </div>
    </div>

    <div class="tabs" role="tablist">
        <button class="tab active" id="btnOrdersTab" role="tab" onclick="showTab('ordersTab')">
            ออเดอร์ <span class="count-pill"><%= orderItems.length %></span>
        </button>
        <button class="tab" id="btnStockTab" role="tab" onclick="showTab('stockTab')">
            สต็อกวัตถุดิบ<% if (soldOut > 0) { %> <span class="badge badge-cancelled plain">หมด <%= soldOut %></span><% } %>
        </button>
    </div>

    <div id="ordersTab">
        <% if (orderItems.length === 0) { %>
            <div class="card empty">
                <div class="empty-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"/></svg>
                </div>
                <h3>ไม่มีออเดอร์ค้าง</h3>
                <p>ออเดอร์ใหม่จะขึ้นที่นี่ทันทีที่ลูกค้ากดส่ง</p>
            </div>
        <% } else { %>
            <div class="ticket-grid">
                <% orderItems.forEach(item => { const isCooking = item.item_status === 'COOKING'; %>
                    <div class="ticket<%= isCooking ? ' is-cooking' : '' %>">
                        <div class="ticket-head">
                            <span class="ticket-table">โต๊ะ <%= item.table_no %></span>
                            <span class="ticket-time"><%= isCooking ? 'กำลังทำ · ' : '' %><%= toTime(item.ordered_at) %></span>
                        </div>
                        <div class="ticket-body">
                            <img class="ticket-thumb" src="<%= item.image_url %>" alt="" onerror="this.style.visibility='hidden'">
                            <div class="ticket-item"><%= item.item_name %></div>
                            <div class="ticket-qty"><small>×</small><%= item.quantity %></div>
                        </div>
                        <div class="ticket-actions">
                            <% if (!isCooking) { %>
                                <button class="btn btn-secondary btn-sm" onclick="updateStatus('<%= item.order_item_id %>', 'COOKING')">เริ่มทำ</button>
                            <% } %>
                            <button class="btn btn-success btn-sm" onclick="updateStatus('<%= item.order_item_id %>', 'READY')">เสร็จแล้ว</button>
                            <button class="btn btn-ghost btn-sm" style="flex: 0 0 auto; color: var(--danger);" onclick="cancelItem('<%= item.order_item_id %>')" title="ยกเลิกเพราะวัตถุดิบหมด">ของหมด</button>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <div id="stockTab" style="display: none;">
        <p class="muted" style="margin-bottom: 14px;">ปิดสวิตช์เมื่อวัตถุดิบหมด เมนูนั้นจะขึ้นว่า "หมดชั่วคราว" ในมือถือลูกค้าทันที</p>
        <div class="stock-grid">
            <% menuItems.forEach(mi => { const on = mi.availability === 1; %>
                <div class="stock-row<%= on ? '' : ' off' %>">
                    <img src="<%= mi.image_url %>" alt="" onerror="this.style.visibility='hidden'">
                    <div>
                        <div class="name"><%= mi.item_name %></div>
                        <span class="badge <%= on ? 'badge-available' : 'badge-cancelled' %>"><%= on ? 'มีของ' : 'หมด' %></span>
                    </div>
                    <button class="switch" role="switch" aria-checked="<%= on %>" aria-label="<%= mi.item_name %>"
                            onclick="toggleStock('<%= mi.menu_item_id %>', '<%= on ? 0 : 1 %>')"></button>
                </div>
            <% }); %>
        </div>
    </div>
</div>

<script>
    const socket = io();

    function showTab(tabId) {
        document.getElementById('ordersTab').style.display = tabId === 'ordersTab' ? 'block' : 'none';
        document.getElementById('stockTab').style.display = tabId === 'stockTab' ? 'block' : 'none';
        document.getElementById('btnOrdersTab').classList.toggle('active', tabId === 'ordersTab');
        document.getElementById('btnStockTab').classList.toggle('active', tabId === 'stockTab');
        location.hash = tabId === 'stockTab' ? 'stock' : '';
    }
    // Stay on the stock tab after a toggle reloads the page
    if (location.hash === '#stock') showTab('stockTab');

    async function updateStatus(order_item_id, status) {
        try {
            const res = await fetch('/kitchen/update-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ order_item_id, status })
            });
            const data = await res.json();
            if (data.success) location.reload();
        } catch (err) {
            alert('เกิดข้อผิดพลาด');
        }
    }

    async function cancelItem(order_item_id) {
        if (!confirm('ยืนยันแจ้งวัตถุดิบหมดและยกเลิกรายการนี้หรือไม่?')) return;
        try {
            const res = await fetch('/kitchen/update-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ order_item_id, status: 'CANCELLED', cancel_reason: 'วัตถุดิบหมด' })
            });
            const data = await res.json();
            if (data.success) location.reload();
        } catch (err) {
            alert('เกิดข้อผิดพลาด');
        }
    }

    async function toggleStock(menu_item_id, availability) {
        try {
            const res = await fetch('/kitchen/toggle-stock', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ menu_item_id, availability })
            });
            const data = await res.json();
            if (data.success) location.reload();
        } catch (err) {
            alert('เกิดข้อผิดพลาดในการปรับสต็อก');
        }
    }

    socket.on('new-order', () => location.reload());
</script>

<%- include('../partials/footer') %>
