<%- include('../partials/header') %>
<%
    // SQLite CURRENT_TIMESTAMP is UTC without a zone marker
    const toTime = s => new Date(String(s).replace(' ', 'T') + 'Z')
        .toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Bangkok' });
    const pending = orderItems.filter(i => i.item_status === 'PENDING').length;
    const cooking = orderItems.filter(i => i.item_status === 'COOKING').length;
    const soldOut = menuItems.filter(m => m.availability === 0).length;
%>

<div class="container">
    <div class="page-head">
        <div>
            <div class="eyebrow">ครัว</div>
            <h1>คิวออเดอร์</h1>
            <p>เรียงตามเวลาสั่ง รายการเก่าสุดอยู่ก่อน</p>
        </div>
        <div class="stat-strip">
            <div class="stat">
                <div class="stat-label"><span class="dot warn"></span>รอทำ</div>
                <div class="stat-value"><%= pending %></div>
            </div>
            <div class="stat">
                <div class="stat-label"><span class="dot" style="background: var(--info);"></span>กำลังทำ</div>
                <div class="stat-value"><%= cooking %></div>
            </div>
        </div>
    </div>

    <div class="tabs" role="tablist">
        <button class="tab active" id="btnOrdersTab" role="tab" onclick="showTab('ordersTab')">
            ออเดอร์ <span class="count-pill"><%= orderItems.length %></span>
        </button>
        <button class="tab" id="btnStockTab" role="tab" onclick="showTab('stockTab')">
            สต็อกวัตถุดิบ<% if (soldOut > 0) { %> <span class="badge badge-cancelled plain">หมด <%= soldOut %></span><% } %>
        </button>
    </div>

    <div id="ordersTab">
        <% if (!orderRounds || orderRounds.length === 0) { %>
            <div class="card empty">
                <div class="empty-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"/></svg>
                </div>
                <h3>ไม่มีออเดอร์ค้าง</h3>
                <p>ออเดอร์ใหม่จะขึ้นที่นี่ทันทีที่ลูกค้ากดส่ง</p>
            </div>
        <% } else { %>
            <div class="kitchen-2col-layout">
                <!-- คอลัมน์ซ้าย: รอคิว WAITING -->
                <div class="kitchen-col-card">
                    <div class="kitchen-col-header">
                        <h2>รอคิว</h2>
                        <span class="badge-pill-waiting">WAITING (<%= pendingRounds ? pendingRounds.length : 0 %>)</span>
                    </div>
                    <% if (!pendingRounds || pendingRounds.length === 0) { %>
                        <div class="empty" style="padding: 40px 10px;">
                            <p class="muted">ไม่มีรายการรอคิว</p>
                        </div>
                    <% } else { %>
                        <div class="round-card-list">
                            <% pendingRounds.forEach((round) => { 
                                const totalItemsCount = round.items.length;
                                const totalQty = round.items.reduce((acc, curr) => acc + curr.quantity, 0);
                            %>
                                <div class="round-card" id="round-card-<%= round.order_id %>">
                                    <div class="round-card-header">
                                        <div class="round-card-title-group">
                                            <span class="round-card-table">โต๊ะ <%= round.table_no %></span>
                                            <span class="round-card-time">สั่งเมื่อ <%= toTime(round.ordered_at) %> น.</span>
                                            <span class="round-card-summary font-sm muted">
                                                <%= totalItemsCount %> รายการ (<%= totalQty %> ชิ้น)
                                            </span>
                                        </div>
                                        <div class="round-card-header-actions">
                                            <button class="btn btn-secondary btn-sm" onclick="updateRoundStatus('<%= round.order_id %>', 'COOKING')" title="เปลี่ยนสถานะทุกรายการเป็นกำลังทำ">เริ่มทำ</button>

                                            <button class="btn-dropdown-toggle" onclick="toggleKitchenDropdown('<%= round.order_id %>')" id="toggle-btn-<%= round.order_id %>">
                                                <span class="toggle-text">ซ่อนรายการ</span>
                                                <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="round-card-dropdown open" id="dropdown-<%= round.order_id %>">
                                        <div class="round-card-items">
                                            <% round.items.forEach(item => { %>
                                                <div class="round-item-row">
                                                    <img class="round-item-thumb" src="<%= item.image_url %>" alt="" onerror="this.style.visibility='hidden'">
                                                    <div class="round-item-details">
                                                        <div class="round-item-name"><%= item.item_name %></div>
                                                    </div>
                                                    <div class="round-item-qty">
                                                        <small>×</small><%= item.quantity %>
                                                    </div>
                                                    <div class="round-item-actions">
                                                        <button class="btn btn-ghost btn-sm" onclick="cancelGeneral('<%= item.order_item_id %>')">ยกเลิก</button>
                                                        <button class="btn btn-ghost btn-sm text-danger" onclick="cancelItem('<%= item.order_item_id %>')" title="ยกเลิกเพราะวัตถุดิบหมด">ของหมด</button>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>

                <!-- คอลัมน์ขวา: กำลังทำ PREPARING -->
                <div class="kitchen-col-card">
                    <div class="kitchen-col-header">
                        <h2>กำลังทำ</h2>
                        <span class="badge-pill-preparing">PREPARING (<%= cookingRounds ? cookingRounds.length : 0 %>)</span>
                    </div>
                    <% if (!cookingRounds || cookingRounds.length === 0) { %>
                        <div class="empty" style="padding: 40px 10px;">
                            <p class="muted">ไม่มีรายการกำลังทำ</p>
                        </div>
                    <% } else { %>
                        <div class="round-card-list">
                            <% cookingRounds.forEach((round) => { 
                                const totalItemsCount = round.items.length;
                                const totalQty = round.items.reduce((acc, curr) => acc + curr.quantity, 0);
                            %>
                                <div class="round-card is-cooking" id="round-card-<%= round.order_id %>">
                                    <div class="round-card-header">
                                        <div class="round-card-title-group">
                                            <span class="round-card-table">โต๊ะ <%= round.table_no %></span>
                                            <span class="round-card-time">สั่งเมื่อ <%= toTime(round.ordered_at) %> น.</span>
                                            <span class="round-card-summary font-sm muted">
                                                <%= totalItemsCount %> รายการ (<%= totalQty %> ชิ้น)
                                            </span>
                                        </div>
                                        <div class="round-card-header-actions">
                                            <button class="btn btn-success btn-sm" onclick="updateRoundStatus('<%= round.order_id %>', 'READY')" title="เปลี่ยนสถานะทุกรายการเป็นเสร็จแล้ว">เสร็จแล้ว</button>

                                            <button class="btn-dropdown-toggle" onclick="toggleKitchenDropdown('<%= round.order_id %>')" id="toggle-btn-<%= round.order_id %>">
                                                <span class="toggle-text">ซ่อนรายการ</span>
                                                <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="round-card-dropdown open" id="dropdown-<%= round.order_id %>">
                                        <div class="round-card-items">
                                            <% round.items.forEach(item => { %>
                                                <div class="round-item-row is-cooking">
                                                    <img class="round-item-thumb" src="<%= item.image_url %>" alt="" onerror="this.style.visibility='hidden'">
                                                    <div class="round-item-details">
                                                        <div class="round-item-name"><%= item.item_name %></div>
                                                    </div>
                                                    <div class="round-item-qty">
                                                        <small>×</small><%= item.quantity %>
                                                    </div>
                                                    <div class="round-item-actions">
                                                        <button class="btn btn-ghost btn-sm" onclick="cancelGeneral('<%= item.order_item_id %>')">ยกเลิก</button>
                                                        <button class="btn btn-ghost btn-sm text-danger" onclick="cancelItem('<%= item.order_item_id %>')" title="ยกเลิกเพราะวัตถุดิบหมด">ของหมด</button>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            </div>
        <% } %>
    </div>

    <div id="stockTab" style="display: none;">
        <p class="muted" style="margin-bottom: 14px;">ปิดสวิตช์เมื่อวัตถุดิบหมด เมนูนั้นจะขึ้นว่า "หมดชั่วคราว" ในมือถือลูกค้าทันที</p>
        <% categories.forEach(category => {
            const categoryItems = menuItems.filter(mi => mi.category_id === category.category_id).sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0));
            if (!categoryItems.length) return;
        %>
        <section class="stock-category" aria-labelledby="stock-category-<%= category.category_id %>">
            <div class="stock-category-heading">
                <h2 id="stock-category-<%= category.category_id %>"><%= category.category_name %></h2>
                <span class="muted"><%= categoryItems.length %> รายการ</span>
            </div>
            <div class="stock-grid">
            <% categoryItems.forEach(mi => { const on = mi.availability === 1; %>
                <div class="stock-row<%= on ? '' : ' off' %>" onclick="toggleStock('<%= mi.menu_item_id %>', '<%= on ? 0 : 1 %>')" style="cursor: pointer;">
                    <img src="<%= mi.image_url %>" alt="" onerror="this.style.visibility='hidden'">
                    <div>
                        <div class="name"><%= mi.item_name %></div>
                        <span class="badge <%= on ? 'badge-available' : 'badge-cancelled' %>"><%= on ? 'มีของ' : 'หมด' %></span>
                    </div>
                    <button class="switch" role="switch" aria-checked="<%= on %>" aria-label="<%= mi.item_name %>"
                            onclick="event.stopPropagation(); toggleStock('<%= mi.menu_item_id %>', '<%= on ? 0 : 1 %>')"></button>
                </div>
            <% }); %>
            </div>
        </section>
        <% }); %>
    </div>
</div>

<script>
    const socket = io({ auth:{ role:'KITCHEN' } });
    const refreshLive = liveRegion(socket, ['#ordersTab','#stockTab','.stat-strip','.tabs'], ['new-order','order-status-changed','stock-updated','session-closed'], () => { if (location.hash === '#stock') showTab('stockTab'); });

    function showTab(tabId) {
        document.getElementById('ordersTab').style.display = tabId === 'ordersTab' ? 'block' : 'none';
        document.getElementById('stockTab').style.display = tabId === 'stockTab' ? 'block' : 'none';
        document.getElementById('btnOrdersTab').classList.toggle('active', tabId === 'ordersTab');
        document.getElementById('btnStockTab').classList.toggle('active', tabId === 'stockTab');
        location.hash = tabId === 'stockTab' ? 'stock' : '';
    }
    // Stay on the stock tab after a toggle reloads the page
    if (location.hash === '#stock') showTab('stockTab');

    function toggleKitchenDropdown(orderId) {
        const dropdown = document.getElementById('dropdown-' + orderId);
        const btn = document.getElementById('toggle-btn-' + orderId);
        if (!dropdown || !btn) return;

        const isOpen = dropdown.classList.contains('open');
        if (isOpen) {
            dropdown.classList.remove('open');
            btn.classList.add('collapsed');
            btn.querySelector('.toggle-text').textContent = 'ดูรายการ';
        } else {
            dropdown.classList.add('open');
            btn.classList.remove('collapsed');
            btn.querySelector('.toggle-text').textContent = 'ซ่อนรายการ';
        }
    }

    async function updateRoundStatus(order_id, status) {
        return sendStaffAction('/kitchen/update-status',{order_id,status},refreshLive);
    }

    async function updateStatus(order_item_id, status) {
        return sendStaffAction('/kitchen/update-status',{order_item_id,status},refreshLive);
    }

    function cancelGeneral(id) { if (confirm('ยกเลิกรายการนี้หรือไม่?')) updateStatus(id, 'CANCELLED'); }
    async function cancelItem(order_item_id) {
        if (!confirm('ยืนยันแจ้งวัตถุดิบหมดและยกเลิกรายการนี้หรือไม่?')) return;
        return sendStaffAction('/kitchen/update-status',{order_item_id,status:'CANCELLED',cancel_reason:'วัตถุดิบหมด',out_of_stock:true},refreshLive);
    }

    async function toggleStock(menu_item_id, availability) {
        return sendStaffAction('/kitchen/toggle-stock',{menu_item_id,availability:Number(availability)},refreshLive);
    }


</script>

<%- include('../partials/footer') %>
