<%- include('../partials/header') %>

<div class="container">
    <div class="card-header" style="border: none; margin-bottom: 20px;">
        <div>
            <h1 style="font-size: 1.8rem; font-weight: 700;">👨‍🍳 หน้าจอพนักงานครัว (Kitchen Dashboard)</h1>
            <p style="color: var(--text-secondary);">จัดการคิวออเดอร์ ปรับสถานะทำอาหาร และเปิด/ปิดสต็อกวัตถุดิบ</p>
        </div>
    </div>

    <!-- Kitchen Tabs -->
    <div style="display: flex; gap: 10px; margin-bottom: 20px;">
        <button class="btn btn-primary" id="btnOrdersTab" onclick="showTab('ordersTab')">🍳 คิวออเดอร์อาหาร</button>
        <button class="btn btn-secondary" id="btnStockTab" onclick="showTab('stockTab')">📦 จัดการสต็อกวัตถุดิบ</button>
    </div>

    <!-- Tab 1: Live Order Queue -->
    <div id="ordersTab">
        <% if (orderItems.length === 0) { %>
            <div class="card" style="text-align: center; padding: 50px;">
                <div style="font-size: 3rem; margin-bottom: 10px;">✅</div>
                <h3>ยังไม่มีคิวออเดอร์ในขณะนี้</h3>
                <p style="color: var(--text-secondary);">เมื่อมีลูกค้าสั่งอาหาร ระบบจะแสดงรายการที่นี่อัตโนมัติแบบ Real-time</p>
            </div>
        <% } else { %>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;">
                <% orderItems.forEach(item => { %>
                    <div class="card" style="margin-bottom: 0; border-left: 5px solid '<%= item.item_status === 'PENDING' ? '#f59e0b' : '#3b82f6' %>';">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                            <span style="font-size: 1.2rem; font-weight: 700; color: var(--brand-red);">โต๊ะ <%= item.table_no %></span>
                            <span class="badge <%= item.item_status === 'PENDING' ? 'badge-pending' : 'badge-cooking' %>">
                                <%= item.item_status === 'PENDING' ? 'รอคิว' : 'กำลังทำ' %>
                            </span>
                        </div>

                        <div style="font-size: 1.1rem; font-weight: 600; margin-bottom: 4px;"><%= item.item_name %></div>
                        <div style="font-size: 1.3rem; font-weight: 700; color: var(--text-primary); margin-bottom: 12px;">
                            จำนวน: <%= item.quantity %> ถาด/จาน
                        </div>

                        <div style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 16px;">
                            เวลาสั่ง: <%= new Date(item.ordered_at).toLocaleTimeString('th-TH') %>
                        </div>

                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <% if (item.item_status === 'PENDING') { %>
                                <button class="btn btn-warning btn-sm" style="flex: 1;" onclick="updateStatus('<%= item.order_item_id %>', 'COOKING')">
                                    🍳 เริ่มทำ
                                </button>
                            <% } %>
                            <% if (item.item_status === 'COOKING' || item.item_status === 'PENDING') { %>
                                <button class="btn btn-success btn-sm" style="flex: 1;" onclick="updateStatus('<%= item.order_item_id %>', 'READY')">
                                    ✅ ทำเสร็จแล้ว
                                </button>
                            <% } %>
                            <button class="btn btn-danger btn-sm" onclick="cancelItem('<%= item.order_item_id %>')">
                                ❌ วัตถุดิบหมด
                            </button>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <!-- Tab 2: Stock Management -->
    <div id="stockTab" style="display: none;">
        <div class="card">
            <h3 style="margin-bottom: 16px;">เปิด / ปิด สต็อกวัตถุดิบชั่วคราว</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px;">
                <% menuItems.forEach(mi => { %>
                    <div style="padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div style="font-weight: 600;"><%= mi.item_name %></div>
                            <span class="badge <%= mi.availability === 1 ? 'badge-available' : 'badge-cancelled' %>">
                                <%= mi.availability === 1 ? 'มีของ' : 'ของหมด' %>
                            </span>
                        </div>
                        <button class="btn btn-sm <%= mi.availability === 1 ? 'btn-danger' : 'btn-success' %>"
                                onclick="toggleStock('<%= mi.menu_item_id %>', '<%= mi.availability === 1 ? 0 : 1 %>')">
                            <%= mi.availability === 1 ? 'ปิด' : 'เปิด' %>
                        </button>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>
</div>

<script>
    const socket = io();

    function showTab(tabId) {
        document.getElementById('ordersTab').style.display = tabId === 'ordersTab' ? 'block' : 'none';
        document.getElementById('stockTab').style.display = tabId === 'stockTab' ? 'block' : 'none';
    }

    async function updateStatus(order_item_id, status) {
        try {
            const res = await fetch('/kitchen/update-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ order_item_id, status })
            });
            const data = await res.json();
            if (data.success) location.reload();
        } catch (err) {
            alert('เกิดข้อผิดพลาด');
        }
    }

    async function cancelItem(order_item_id) {
        if (!confirm('ยืนยันแจ้งวัตถุดิบหมดและยกเลิกรายการนี้หรือไม่?')) return;
        try {
            const res = await fetch('/kitchen/update-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ order_item_id, status: 'CANCELLED', cancel_reason: 'วัตถุดิบหมด' })
            });
            const data = await res.json();
            if (data.success) location.reload();
        } catch (err) {
            alert('เกิดข้อผิดพลาด');
        }
    }

    async function toggleStock(menu_item_id, availability) {
        try {
            const res = await fetch('/kitchen/toggle-stock', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ menu_item_id, availability })
            });
            const data = await res.json();
            if (data.success) location.reload();
        } catch (err) {
            alert('เกิดข้อผิดพลาดในการปรับสต็อก');
        }
    }

    // Real-time listener
    socket.on('new-order', () => {
        location.reload();
    });
</script>

<%- include('../partials/footer') %>
