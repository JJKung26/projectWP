<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title : 'ระบบสั่งอาหารร้านหมูกระทะ' %>
    </title>
    <%- include('styles') %>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/print.js"></script>
    <script src="/js/ui.js"></script><script src="/js/live.js"></script>
</head>
<body class="staff">
    <header class="navbar no-print">
        <a href="<%= typeof staff !== 'undefined' && staff ? HOME_BY_ROLE[staff.role] : '/login' %>" class="brand">
            <svg class="brand-logo" viewBox="0 0 100 100" aria-hidden="true">
                <circle cx="50" cy="50" r="50" fill="#c8401a" />
                <path d="M24 60 Q50 20 76 60 Z" fill="#fff" />
                <path d="M18 60h64" stroke="#fff" stroke-width="5" stroke-linecap="round" />
                <path d="M35 54l5-8M47 54l3-11M57 54l2-9M67 54l-1-6" stroke="#c8401a" stroke-width="3"
                    stroke-linecap="round" />
            </svg>
            <span class="brand-name">ร้านหมูกระทะ บุฟเฟต์</span>
            <span class="brand-sub">หลังร้าน</span>
        </a>
        <nav class="nav-links">
            <% if (staff && ['ADMIN','CASHIER'].includes(staff.role)) { %>
            <a href="/cashier/tables" class="nav-link" data-match="/cashier">แคชเชียร์</a>
            <% } %>
            <% if (staff && ['ADMIN','KITCHEN'].includes(staff.role)) { %>
            <a href="/kitchen" class="nav-link" data-match="/kitchen">ครัว</a>
            <% } %>
            <% if (staff && ['ADMIN','SERVICE'].includes(staff.role)) { %>
            <a href="/serving" class="nav-link" data-match="/serving">เสิร์ฟ</a>
            <% } %>
            <% if (typeof staff !=='undefined' && staff) { %>
                <div class="nav-user">
                    <span class="nav-user-name"><%= staff.full_name %></span>
                    <form method="POST" action="/logout">
                        <input type="hidden" name="role" value="<%= staff.role %>">
                        <button type="submit" class="btn btn-secondary btn-sm">ออกจากระบบ</button>
                    </form>
                </div>
                <% } %>
        </nav>
    </header>
    <script>
        document.querySelectorAll('.nav-link').forEach(a => {
            if (location.pathname.startsWith(a.dataset.match)) a.classList.add('active');
        });
    </script>
