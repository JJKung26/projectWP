<%- include('head', { scripts: ['print', 'ui', 'live'] }) %>
<body>
  <%# โลโก้ร้านและลิงก์กลับหน้าแรกตามหน้าที่ของพนักงาน %>
  <header class="navbar no-print row between">
    <a href="<%= HOME_BY_ROLE[staff.role] %>" class="row">
      <%- include('brand-logo', { logoClass: 'brand-logo' }) %>
      <span class="number">ร้านหมูกระทะ บุฟเฟต์</span>
      <span class="brand-sub small muted">หลังร้าน</span>
    </a>
    <%# แสดงเมนูตามสิทธิ์ แคชเชียร์ ครัว หรือเสิร์ฟ %>
    <nav class="nav-links row">
      <% if (['ADMIN', 'CASHIER'].includes(staff.role)) { %>
        <a href="/cashier/tables" class="nav-link row" data-match="/cashier">แคชเชียร์</a>
      <% } %>
      <% if (['ADMIN', 'KITCHEN'].includes(staff.role)) { %>
        <a href="/kitchen" class="nav-link row" data-match="/kitchen">ครัว</a>
      <% } %>
      <% if (['ADMIN', 'SERVICE'].includes(staff.role)) { %>
        <a href="/serving" class="nav-link row" data-match="/serving">เสิร์ฟ</a>
      <% } %>
      <%# ชื่อพนักงานและปุ่มออกจากระบบของหน้าที่นี้ %>
      <div class="row">
        <span class="nav-user-name small"><%= staff.full_name %></span>
        <form method="POST" action="/logout">
          <input type="hidden" name="role" value="<%= staff.role %>" />
          <button type="submit" class="btn btn-sm inline-row">ออกจากระบบ</button>
        </form>
      </div>
    </nav>
  </header>
