<%# ตัวเลือกกระดาษ 80 หรือ 58 มม. ใช้ร่วมกับใบ QR บัตรคิว และใบเสร็จ %>
<fieldset class="paper-picker">
  <legend>ขนาดกระดาษ</legend>
  <div class="grid-2 paper-options choices">
    <% for (const value of ['80', '58']) { %>
      <label>
        <input type="radio" class="paper-size" name="<%= paperId %>" value="<%= value %>"
          <%= value === '80' ? 'checked' : '' %> />
        <span><strong><%= value %> มม.</strong> <small>ใบเสร็จ</small></span>
      </label>
    <% } %>
  </div>
</fieldset>
