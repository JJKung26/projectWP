<% const children = session.child_count || 0, freeChildren = session.free_child_count || 0;
   const adults = session.guest_count - children - freeChildren;
   const method = paid ? {CASH:'CASH · เงินสด',PROMPTPAY:'พร้อมเพย์',CREDIT_CARD:'บัตร (จำลอง)'}[payment.payment_method] : '';
   // แสดงเฉพาะรายการคิดเงินเพิ่ม และรวมรายการซ้ำที่สั่งด้วยราคาเดียวกัน
   const itemGroups = new Map();
   for (const item of items) {
       if (item.charge_type !== 'ALACARTE' || item.quantity * item.unit_price_at_order <= 0) continue;
       const key = JSON.stringify([item.menu_item_id, item.item_name, item.charge_type, item.unit_price_at_order]);
       if (itemGroups.has(key)) itemGroups.get(key).quantity += item.quantity;
       else itemGroups.set(key, { ...item });
   } %>
<article class="receipt-slip payment-receipt" id="billPrintArea">
    <header class="receipt-heading">
        <%- include('shop-logo', {logoClass:'receipt-logo'}) %>
        <h1><%= paid ? 'ใบเสร็จรับเงิน / RECEIPT' : 'ใบตรวจสอบยอด / CHECK BILL' %></h1>
        <p class="receipt-shop">ร้านหมูกระทะ บุฟเฟต์</p>
    </header>
    <div class="receipt-meta">
        <% if (paid) { %>
        <p>เลขที่: <%= bill.receipt_no %></p>
        <div class="receipt-line"><span>ผู้รับเงิน: <%= payment.received_by %></span><span><%= thaiDate(payment.paid_at) %></span></div>
        <% } else { %>
        <p>รอบบริการ: <%= session.session_id.slice(0,8).toUpperCase() %></p>
        <p>เปิดโต๊ะ: <%= thaiDate(session.started_at) %></p>
        <% } %>
    </div>
    <div class="receipt-dining">
        <p>DINE IN | ลูกค้า: <%= session.guest_count %> ท่าน</p>
        <h2>TABLE No. <%= session.table_no %></h2>
    </div>
    <table class="receipt-items" aria-label="รายการที่คิดเงิน">
        <colgroup><col><col class="receipt-quantity"><col class="receipt-amount"></colgroup>
        <thead><tr><th>รายการ</th><th class="r">จำนวน</th><th class="r">บาท</th></tr></thead>
        <tbody>
            <% for (const [label, count, price] of [['บุฟเฟต์ ผู้ใหญ่',adults,session.buffet_price],['บุฟเฟต์ เด็ก 90–120 ซม.',children,session.child_price ?? 179]]) { if (count * price > 0) { %>
            <tr><td><%= label %><span class="buffet-rate"><%= price.toFixed(2) %> บาท/ท่าน</span></td><td class="r"><%= count %></td><td class="r"><%= (count*price).toFixed(2) %></td></tr>
            <% } } %>
            <% itemGroups.forEach(i => { %>
            <tr><td><%= i.item_name %><small style="display:block"><%= i.unit_price_at_order.toFixed(2) %> บาท/หน่วย</small></td><td class="r"><%= i.quantity %></td><td class="r"><%= (i.quantity*i.unit_price_at_order).toFixed(2) %></td></tr>
            <% }); %>
        </tbody>
    </table>
    <div class="receipt-totals">
        <div class="receipt-line"><span>Subtotal · ก่อน VAT</span><span><%= subtotal.toFixed(2) %></span></div>
        <div class="receipt-line"><span>VAT 7%</span><span><%= taxAmount.toFixed(2) %></span></div>
        <div class="receipt-line"><span>Before Rounding</span><span><%= beforeRounding.toFixed(2) %></span></div>
        <div class="receipt-line"><span>Rounding · ปัดเศษ</span><span><%= roundingAmount.toFixed(2) %></span></div>
        <div class="receipt-line receipt-grand-total"><strong>Grand Total</strong><strong><%= netAmount.toFixed(2) %></strong></div>
    </div>
    <% if (paid) { %>
    <div class="receipt-payment">
        <div class="receipt-line"><span><%= method %></span><span><%= payment.amount_received.toFixed(2) %></span></div>
        <div class="receipt-line"><span>CHANGE · เงินทอน</span><span><%= payment.change_amount.toFixed(2) %></span></div>
    </div>
    <% } %>
    <footer class="receipt-footer">
        <p>VAT INCLUDED · ยอดรวม VAT 7% แล้ว</p>
        <p><%= paid ? 'PAID · ชำระเงินแล้ว' : 'UNPAID · ยังไม่ชำระ' %></p>
        <p><%= paid ? 'ขอบคุณที่ใช้บริการ' : 'ใบนี้ไม่ใช่หลักฐานการชำระเงิน' %></p>
    </footer>
</article>
