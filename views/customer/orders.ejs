<%
    // SQLite CURRENT_TIMESTAMP is UTC without a zone marker
    const toTime = s => new Date(String(s).replace(' ', 'T') + 'Z')
        .toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Bangkok' });
    const statusInfo = {
        PENDING:   { cls: 'badge-pending',   label: 'รอคิวครัว' },
        COOKING:   { cls: 'badge-cooking',   label: 'กำลังเตรียม' },
        READY:     { cls: 'badge-ready',     label: 'กำลังนำไปเสิร์ฟ' },
        SERVED:    { cls: 'badge-served',    label: 'เสิร์ฟแล้ว' },
        CANCELLED: { cls: 'badge-cancelled', label: 'ยกเลิก' }
    };
    const count = st => orders.filter(o => o.item_status === st).reduce((n, o) => n + o.quantity, 0);
    const groups = [];
    orders.forEach(o => {
        let g = groups.find(x => x.order_id === o.order_id);
        if (!g) { g = { order_id: o.order_id, ordered_at: o.ordered_at, items: [] }; groups.push(g); }
        g.items.push(o);
    });
%>
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#ffffff">
    <title>ออเดอร์ · โต๊ะ <%= session.table_no %></title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/socket.io/socket.io.js"></script>
</head>
<body class="cust" style="background: var(--paper);">

    <header class="app-bar">
        <a class="icon-btn" href="/menu?token=<%= token %>" aria-label="กลับไปเมนู">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
        </a>
        <h1>ออเดอร์ของโต๊ะ <%= session.table_no %></h1>
        <span class="muted" style="font-size: 0.85rem; padding-right: 8px;"><%= session.guest_count %> ท่าน</span>
    </header>

    <main class="cust-wrap cust-shell">
        <% if (orders.length === 0) { %>
            <div class="empty">
                <div class="empty-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 2"/></svg>
                </div>
                <h3>ยังไม่ได้สั่งอะไรเลย</h3>
                <p>เลือกเมนูแล้วกดส่งเข้าครัว สถานะจะอัปเดตที่หน้านี้เอง</p>
                <a href="/menu?token=<%= token %>" class="btn btn-primary" style="margin-top: 18px;">ไปเลือกเมนู</a>
            </div>
        <% } else { %>
            <div class="status-summary">
                <div><b><%= count('PENDING') %></b><small>รอคิว</small></div>
                <div><b><%= count('COOKING') %></b><small>กำลังเตรียม</small></div>
                <div><b><%= count('READY') %></b><small>กำลังมา</small></div>
                <div><b><%= count('SERVED') %></b><small>เสิร์ฟแล้ว</small></div>
            </div>

            <% 
                // Display newest round first, but with correct chronological round number
                const reversedGroups = groups.map((g, idx) => ({ ...g, roundNum: idx + 1 })).reverse();
                reversedGroups.forEach((g, idx) => { 
                    const totalQty = g.items.reduce((sum, i) => sum + i.quantity, 0);
                    const isLatest = idx === 0;
                    
                    // Determine round status
                    const statuses = g.items.map(i => i.item_status);
                    let roundBadgeCls = 'badge-pending';
                    let roundBadgeLabel = 'รอคิวครัว';
                    if (statuses.every(s => s === 'SERVED')) {
                        roundBadgeCls = 'badge-served';
                        roundBadgeLabel = 'เสิร์ฟครบแล้ว';
                    } else if (statuses.some(s => s === 'READY')) {
                        roundBadgeCls = 'badge-ready';
                        roundBadgeLabel = 'กำลังนำมาเสิร์ฟ';
                    } else if (statuses.some(s => s === 'COOKING')) {
                        roundBadgeCls = 'badge-cooking';
                        roundBadgeLabel = 'กำลังเตรียม';
                    } else if (statuses.every(s => s === 'CANCELLED')) {
                        roundBadgeCls = 'badge-cancelled';
                        roundBadgeLabel = 'ยกเลิกทั้งรอบ';
                    }
            %>
                <div class="cust-round-card">
                    <div class="cust-round-header" onclick="toggleCustDropdown('<%= g.order_id %>')">
                        <div class="cust-round-title">
                            <span class="cust-round-badge">รอบที่ <%= g.roundNum %></span>
                            <span class="cust-round-time">สั่งเมื่อ <%= toTime(g.ordered_at) %> น.</span>
                        </div>
                        <div class="cust-round-meta">
                            <span class="badge <%= roundBadgeCls %>"><%= roundBadgeLabel %></span>
                            <button class="cust-dropdown-btn<%= isLatest ? '' : ' collapsed' %>" id="cust-btn-<%= g.order_id %>" type="button" aria-label="แสดง/ซ่อนรายการ">
                                <span class="muted" style="font-size: 0.8rem;"><%= g.items.length %> รายการ</span>
                                <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                            </button>
                        </div>
                    </div>
                    <div class="cust-round-dropdown<%= isLatest ? ' open' : '' %>" id="cust-dropdown-<%= g.order_id %>">
                        <div class="order-list">
                            <% g.items.forEach(item => { const st = statusInfo[item.item_status] || statusInfo.PENDING; %>
                                <div class="order-line<%= item.item_status === 'CANCELLED' ? ' cancelled' : '' %>">
                                    <img src="<%= item.image_url %>" alt="" onerror="this.style.visibility='hidden'">
                                    <div class="nm">
                                        <%= item.item_name %>
                                        <small>× <%= item.quantity %><% if (item.item_status === 'CANCELLED') { %> · <%= item.cancel_reason || 'วัตถุดิบหมด' %><% } %></small>
                                    </div>
                                    <span class="badge <%= st.cls %>"><%= st.label %></span>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
            <% }); %>

            <a href="/menu?token=<%= token %>" class="btn btn-secondary btn-block" style="margin-top: 22px;">สั่งอาหารเพิ่ม</a>
        <% } %>
    </main>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
        if (new URLSearchParams(location.search).get('sent')) {
            const t = document.getElementById('toast');
            t.textContent = 'ส่งออเดอร์เข้าครัวเรียบร้อยแล้ว';
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2600);
            history.replaceState(null, '', location.pathname + '?token=<%= token %>');
        }

        function toggleCustDropdown(orderId) {
            const dropdown = document.getElementById('cust-dropdown-' + orderId);
            const btn = document.getElementById('cust-btn-' + orderId);
            if (!dropdown || !btn) return;

            const isOpen = dropdown.classList.contains('open');
            if (isOpen) {
                dropdown.classList.remove('open');
                btn.classList.add('collapsed');
            } else {
                dropdown.classList.add('open');
                btn.classList.remove('collapsed');
            }
        }

        const socket = io();
        socket.on('order-status-changed', () => location.reload());
    </script>
</body>
</html>
