<%# ชื่อและสีของแต่ละสถานะ พร้อมนับจำนวนอาหารในโต๊ะ %>
<%
  const statusInfo = {
    PENDING: { cls: 'badge-pending', label: 'รอคิวครัว' },
    COOKING: { cls: 'badge-cooking', label: 'กำลังเตรียม' },
    READY: { cls: 'badge-ready', label: 'กำลังนำไปเสิร์ฟ', roundLabel: 'กำลังนำมาเสิร์ฟ' },
    SERVED: { cls: 'badge-served', label: 'เสิร์ฟแล้ว', roundLabel: 'เสิร์ฟครบแล้ว' },
    CANCELLED: { cls: 'badge-cancelled', label: 'ยกเลิก', roundLabel: 'ยกเลิกทั้งรอบ' }
  };
  const summary = { PENDING: 0, COOKING: 0, READY: 0, SERVED: 0, CANCELLED: 0 };
  for (const item of orders) summary[item.item_status] += item.quantity;
%>
<%-
  include('../partials/head', {
    title: 'ออเดอร์ · โต๊ะ ' + session.table_no,
    scripts: ['ui', 'live']
  })
%>
<body class="cust">
  <%# หัวข้อโต๊ะ จำนวนลูกค้า และปุ่มกลับไปเลือกอาหาร %>
  <header class="app-bar row">
    <a class="icon-btn plain-button center" href="/menu?token=<%= token %>" aria-label="กลับไปเมนู">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 5l-7 7 7 7" />
      </svg>
    </a>
    <h1>ออเดอร์ของโต๊ะ <%= session.table_no %></h1>
    <span class="muted" style="font-size: 0.85rem; padding-right: 8px;">
      <%= session.guest_count %> ท่าน
    </span>
  </header>
  <main class="cust-wrap cust-shell">
    <%# ข้อความและปุ่มเลือกเมนูเมื่อยังไม่มีออเดอร์ %>
    <% if (orders.length === 0) { %>
      <div class="text-center empty">
        <div class="empty-icon center">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.8" stroke-linecap="round">
            <circle cx="12" cy="12" r="8" />
            <path d="M12 8v4l2.5 2" />
          </svg>
        </div>
        <h3>ยังไม่ได้สั่งอะไรเลย</h3>
        <p>เลือกเมนูแล้วกดส่งเข้าครัว สถานะจะอัปเดตที่หน้านี้เอง</p>
        <a href="/menu?token=<%= token %>" class="btn btn-primary inline-row"
          style="margin-top: 18px;">ไปเลือกเมนู</a>
      </div>
    <% } else { %>
      <%# ยอดรวมรอคิว กำลังเตรียม กำลังมา และเสิร์ฟแล้ว %>
      <div class="text-center status-summary">
        <div class="box">
          <b class="number digits"><%= summary.PENDING %></b>
          <small>รอคิว</small>
        </div>
        <div class="box">
          <b class="number digits"><%= summary.COOKING %></b>
          <small>กำลังเตรียม</small>
        </div>
        <div class="box">
          <b class="number digits"><%= summary.READY %></b>
          <small>กำลังมา</small>
        </div>
        <div class="box">
          <b class="number digits"><%= summary.SERVED %></b>
          <small>เสิร์ฟแล้ว</small>
        </div>
      </div>
      <%
        // แสดงรอบล่าสุดก่อน แล้วดูสถานะอาหารที่ยังไม่ถูกยกเลิก
        for (let idx = groups.length - 1; idx >= 0; idx--) {
          const g = groups[idx];
          const isLatest = idx === groups.length - 1;
          const badge = statusInfo[g.status];
      %>
        <%# หัวข้อแต่ละรอบ เวลา สถานะ และปุ่มพับรายการ %>
        <div class="cust-round-card box">
          <div class="cust-round-header row between wrap"
            onclick="toggleOrderDropdown('<%= g.order_id %>')">
            <div class="cust-round-title row">
              <span class="cust-round-badge">รอบที่ <%= g.round_no %></span>
              <span
                class="cust-round-time digits small muted">
                  สั่งเมื่อ <%= thaiTime(g.ordered_at) %> น.</span>
            </div>
            <div class="cust-round-meta row wrap">
              <span class="badge <%= badge.cls %> inline-row">
                <%= badge.roundLabel || badge.label %>
              </span>
              <button class="cust-dropdown-btn<%= isLatest ? '' : ' collapsed' %> row plain-button"
                id="toggle-btn-<%= g.order_id %>" type="button" aria-label="แสดง/ซ่อนรายการ">
                <span class="muted" style="font-size: 0.8rem;"><%= g.items.length %> รายการ</span>
                <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </button>
            </div>
          </div>
          <div class="order-dropdown<%= isLatest ? ' open' : '' %>" id="dropdown-<%= g.order_id %>"
            data-order="<%= g.order_id %>">
            <%# รูป ชื่อ จำนวน และสถานะของอาหารในรอบ %>
            <div class="order-list">
              <%
                for (const item of g.items) {
                  const st = statusInfo[item.item_status];
              %>
                <div
                  class="order-line<%= item.item_status === 'CANCELLED' ? ' cancelled' : '' %> row">
                  <img src="<%= item.image_url %>" alt="" />
                  <div class="nm">
                    <%= item.item_name %>
                    <small>
                      × <%= item.quantity %>
                      <% if (item.item_status === 'CANCELLED') { %>
                        · <%= item.cancel_reason || 'วัตถุดิบหมด' %>
                      <% } %>
                    </small>
                  </div>
                  <span class="badge <%= st.cls %> inline-row"><%= st.label %></span>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>
      <a href="/menu?token=<%= token %>" class="btn btn-secondary btn-block inline-row"
        style="margin-top: 22px;">สั่งอาหารเพิ่ม</a>
    <% } %>
  </main>
  <%# แจ้งส่งออเดอร์สำเร็จ และโหลดโค้ดอัปเดตสถานะ %>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>const TOKEN = '<%= token %>';</script>
  <script src="/js/customer-orders.js"></script>
  <%- include('../partials/footer') %>
