<%# ชื่อและสีของแต่ละสถานะ พร้อมนับจำนวนอาหารในโต๊ะ %>
<%
  const statusInfo = {
    PENDING: { className: 'badge-pending', label: 'รอคิวครัว' },
    COOKING: { className: 'badge-cooking', label: 'กำลังเตรียม' },
    READY: { className: 'badge-ready', label: 'กำลังนำไปเสิร์ฟ', roundLabel: 'กำลังนำมาเสิร์ฟ' },
    SERVED: { className: 'badge-served', label: 'เสิร์ฟแล้ว', roundLabel: 'เสิร์ฟครบแล้ว' },
    CANCELLED: { className: 'badge-cancelled', label: 'ยกเลิก', roundLabel: 'ยกเลิกทั้งรอบ' }
  };
  const summary = { PENDING: 0, COOKING: 0, READY: 0, SERVED: 0, CANCELLED: 0 };
  const summaryLabels = {
    PENDING: 'รอคิว', COOKING: 'กำลังเตรียม', READY: 'กำลังมา', SERVED: 'เสิร์ฟแล้ว'
  };
  for (const item of orders) summary[item.item_status] += item.quantity;
%>
<%- include('../partials/head', {
  title: 'ออเดอร์ · โต๊ะ ' + session.table_no, scripts: ['ui', 'live']
}) %>
<body>
  <%# หัวข้อโต๊ะ จำนวนลูกค้า และปุ่มกลับไปเลือกอาหาร %>
  <header class="app-bar row">
    <a class="icon-btn plain-button center" href="/menu?token=<%= token %>" aria-label="กลับไปเมนู">
      <img src="/images/icons/back.svg" width="20" height="20" alt="" />
    </a>
    <h1>ออเดอร์ของโต๊ะ <%= session.table_no %></h1>
    <span class="muted" style="font-size: 0.85rem; padding-right: 8px;">
      <%= session.guest_count %> ท่าน
    </span>
  </header>
  <main class="cust-wrap cust-shell">
    <%# ข้อความและปุ่มเลือกเมนูเมื่อยังไม่มีออเดอร์ %>
    <% if (orders.length === 0) { %>
      <div class="text-center empty">
        <div class="empty-icon center">
          <img src="/images/icons/clock.svg" width="24" height="24" alt="" />
        </div>
        <h3>ยังไม่ได้สั่งอะไรเลย</h3>
        <p>เลือกเมนูแล้วกดส่งเข้าครัว สถานะจะอัปเดตที่หน้านี้เอง</p>
        <a href="/menu?token=<%= token %>" class="btn btn-primary inline-row"
          style="margin-top: 18px;">ไปเลือกเมนู</a>
      </div>
    <% } else { %>
      <%# ยอดรวมรอคิว กำลังเตรียม กำลังมา และเสิร์ฟแล้ว %>
      <div class="text-center status-summary">
        <% for (const status in summaryLabels) { %>
          <div class="box">
            <b class="number digits"><%= summary[status] %></b>
            <small><%= summaryLabels[status] %></small>
          </div>
        <% } %>
      </div>
      <%
        // แสดงรอบล่าสุดก่อน แล้วดูสถานะอาหารที่ยังไม่ถูกยกเลิก
        for (let index = groups.length - 1; index >= 0; index--) {
          const group = groups[index];
          const isLatest = index === groups.length - 1;
          const badge = statusInfo[group.status];
      %>
        <%# หัวข้อแต่ละรอบ เวลา สถานะ และปุ่มพับรายการ %>
        <div class="cust-round-card box">
          <div class="cust-round-header row between wrap"
            onclick="toggleOrderDropdown('<%= group.order_id %>')">
            <div class="row">
              <span class="cust-round-badge">รอบที่ <%= group.round_no %></span>
              <span class="digits small muted">สั่งเมื่อ <%= thaiTime(group.ordered_at) %> น.</span>
            </div>
            <div class="row wrap">
              <span class="badge <%= badge.className %> inline-row">
                <%= badge.roundLabel || badge.label %>
              </span>
              <button class="<%= isLatest ? '' : ' collapsed' %> row plain-button"
                id="toggle-btn-<%= group.order_id %>" type="button" aria-label="แสดง/ซ่อนรายการ">
                <span class="muted" style="font-size: 0.8rem;">
                  <%= group.items.length %> รายการ
                </span>
                <img class="chevron-icon" src="/images/icons/chevron.svg"
                  width="16" height="16" alt="" />
              </button>
            </div>
          </div>
          <div class="order-dropdown<%= isLatest ? ' open' : '' %>"
            id="dropdown-<%= group.order_id %>"
            data-order="<%= group.order_id %>">
            <%# รูป ชื่อ จำนวน และสถานะของอาหารในรอบ %>
            <div>
              <%
                for (const item of group.items) {
                  const statusDetail = statusInfo[item.item_status];
              %>
                <div
                  class="order-line<%= item.item_status === 'CANCELLED' ? ' cancelled' : '' %> row">
                  <img src="<%= item.image_url %>" alt="" />
                  <div class="nm">
                    <%= item.item_name %>
                    <small>
                      × <%= item.quantity %>
                      <% if (item.item_status === 'CANCELLED') { %>
                        · <%= item.cancel_reason || 'วัตถุดิบหมด' %>
                      <% } %>
                    </small>
                  </div>
                  <span class="badge <%= statusDetail.className %> inline-row">
                    <%= statusDetail.label %>
                  </span>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>
      <a href="/menu?token=<%= token %>" class="btn btn-block inline-row"
        style="margin-top: 22px;">สั่งอาหารเพิ่ม</a>
    <% } %>
  </main>
  <%# แจ้งส่งออเดอร์สำเร็จ และโหลดโค้ดอัปเดตสถานะ %>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>const TOKEN = '<%= token %>';</script>
  <script src="/js/customer-orders.js"></script>
  <%- include('../partials/footer') %>
