<%- include('../partials/head', {
  title: 'เมนู · โต๊ะ ' + session.table_no, scripts: ['ui', 'live']
}) %>
<body class="menu-page">
  <div class="cust-shell">
    <%# หมายเลขโต๊ะ จำนวนลูกค้า และลิงก์ดูออเดอร์ %>
    <header class="hero">
      <div class="row between">
        <span class="table-pill inline-row box">
          <span>โต๊ะ <%= session.table_no %></span>
          <span><%= session.guest_count %> ท่าน</span>
        </span>
        <a class="icon-btn box center" href="/orders?token=<%= token %>"
          aria-label="ออเดอร์ของโต๊ะ">
          <img src="/images/icons/orders.svg" width="22" height="22" alt="" />
        </a>
      </div>
    </header>
    <%# โลโก้ ชื่อร้าน และคำอธิบายราคา %>
    <div class="text-center shop-head">
      <%- include('../partials/shop-logo', { logoClass: 'shop-logo' }) %>
      <h1>ร้านหมูกระทะ บุฟเฟต์</h1>
      <p>สั่งได้ไม่อั้น รายการที่มีราคาคิดเพิ่ม · ราคายังไม่รวม VAT 7%</p>
    </div>
    <%# ปุ่มค้นหา หมวดทั้งหมด และแท็บเลื่อนไปแต่ละหมวด %>
    <nav class="flex cat-bar" aria-label="หมวดหมู่">
      <button class="cat-tool plain-button center" onclick="openSearch()" aria-label="ค้นหาเมนู">
        <img src="/images/icons/search.svg" width="22" height="22" alt="" />
      </button>
      <button class="cat-tool plain-button center" onclick="openCatSheet()"
        aria-label="หมวดหมู่ทั้งหมด">
        <img src="/images/icons/categories.svg" width="22" height="22" alt="" />
      </button>
      <div class="flex cat-scroll">
        <%
          for (let i = 0; i < sections.length; i++) {
            const cat = sections[i];
        %>
          <a class="category-tab<%= i === 0 ? ' active' : '' %>" href="#cat-<%= cat.category_id %>"
            data-cat="<%= cat.category_id %>"><%= cat.category_name %></a>
        <% } %>
      </div>
    </nav>
    <%# ช่องค้นหาที่กรองเมนูเมื่อพิมพ์ %>
    <div class="search-bar">
      <label class="search-field row">
        <img src="/images/icons/search.svg" width="20" height="20" alt="" />
        <input type="search" id="searchInput" placeholder="ค้นหาชื่อเมนู"
          oninput="filterMenu(this.value)" autocomplete="off" />
      </label>
      <button class="plain-button" onclick="closeSearch()">ยกเลิก</button>
    </div>
    <%# แสดงอาหารตามหมวด พร้อมรูป ราคา ของหมด และช่องปุ่มจำนวน %>
    <main>
      <% for (const cat of sections) { %>
        <section class="menu-section" id="cat-<%= cat.category_id %>"
          data-cat="<%= cat.category_id %>">
          <h2><%= cat.category_name %></h2>
          <%
            for (const item of cat.items) {
              const soldOut = item.availability === 0;
          %>
            <article class="flex menu-row<%= soldOut ? ' sold-out' : '' %>"
              data-id="<%= item.menu_item_id %>"
              data-name="<%= item.item_name %> <%= item.description || '' %>">
              <div class="menu-thumb">
                <img src="<%= item.image_url %>" alt="<%= item.item_name %>" loading="lazy" />
                <span class="sold-tag" <%= soldOut ? '' : 'hidden' %>>หมดชั่วคราว</span>
              </div>
              <div class="menu-info column">
                <div class="menu-name"><%= item.item_name %></div>
                <% if (item.description) { %>
                  <div class="small muted"><%= item.description %></div>
                <% } %>
                <div class="menu-foot row between">
                  <% if (item.charge_type === 'BUFFET') { %>
                    <span class="small muted">รวมในบุฟเฟต์</span>
                  <% } else { %>
                    <span class="number small muted">฿<%= item.unit_price.toFixed(0) %></span>
                  <% } %>
                  <div class="ctl" data-id="<%= item.menu_item_id %>"></div>
                </div>
              </div>
            </article>
          <% } %>
        </section>
      <% } %>
      <p class="text-center" id="noResult" hidden>ไม่พบเมนูที่ค้นหา</p>
    </main>
  </div>
  <%# แถบล่างแสดงจำนวนอาหารที่เลือกและเปิดตะกร้า %>
  <button type="button" class="cart-bar row plain-button between" id="cartBar"
    onclick="openSheet('sheet')">
    <span class="badge center digits" id="cartCount">0</span>
    <span>ดูรายการที่เลือก</span>
    <span class="extra digits" id="cartExtra"></span>
  </button>
  <%# ป๊อปอัปตะกร้า แสดงค่าอาหารเพิ่มและปุ่มส่งเข้าครัว %>
  <dialog class="sheet column" id="sheet" role="dialog" aria-modal="true"
    aria-labelledby="sheetTitle">
    <div class="sheet-head row between">
      <h3 id="sheetTitle">รายการที่จะส่งเข้าครัว</h3>
      <button class="icon-btn plain-button center" onclick="closeSheets()" aria-label="ปิด">
        <img src="/images/icons/close.svg" width="16" height="16" alt="" />
      </button>
    </div>
    <%# cart.js ใส่รายการอาหารที่เลือกลงในพื้นที่นี้ %>
    <div class="sheet-body" id="sheetBody"></div>
    <div class="sheet-foot">
      <div class="between flex sheet-total">
        <span>ค่าใช้จ่ายเพิ่มจากบุฟเฟต์</span>
        <b class="digits" id="sheetExtra">฿0</b>
      </div>
      <button class="btn btn-primary btn-lg btn-block inline-row" id="sendBtn"
        onclick="submitOrder()">ส่งออเดอร์เข้าครัว</button>
    </div>
  </dialog>
  <%# ป๊อปอัปเลือกหมวดอาหารทั้งหมด %>
  <dialog class="sheet column" id="catSheet" role="dialog" aria-modal="true"
    aria-labelledby="catSheetTitle">
    <div class="sheet-head row between">
      <h3 id="catSheetTitle">หมวดหมู่ทั้งหมด</h3>
      <button class="icon-btn plain-button center" onclick="closeSheets()" aria-label="ปิด">
        <img src="/images/icons/down.svg" width="16" height="16" alt="" />
      </button>
    </div>
    <div class="sheet-body">
      <ul class="cat-list">
        <% for (const cat of sections) { %>
          <li>
            <a class="row between" href="#cat-<%= cat.category_id %>"
              data-cat="<%= cat.category_id %>" onclick="closeSheets()">
              <span><%= cat.category_name %> <small><%= cat.items.length %></small></span>
              <img class="tick" src="/images/icons/tick.svg" width="18" height="18" alt="" />
            </a>
          </li>
        <% } %>
      </ul>
    </div>
  </dialog>
  <%# ส่งรหัสโต๊ะและข้อมูลเมนูให้ JavaScript จัดตะกร้าและอัปเดตสต็อก %>
  <script>
    const TOKEN = '<%= token %>';
    const ITEMS = <%- JSON.stringify(cartItems).replace(/</g, '\\u003c') %>;
  </script>
  <script src="/js/cart.js"></script>
  <script src="/js/customer.js"></script>
  <%- include('../partials/footer') %>
