<dialog class="modal-overlay row" id="occupiedTableModal" aria-labelledby="occupiedTableModalTitle">
  <div class="modal-content">
    <%# แสดงโต๊ะที่เลือกและปุ่มปิดป๊อปอัป %>
    <div class="modal-head row between">
      <div>
        <h2 id="occupiedTableModalTitle">โต๊ะ <span id="occTableNo"></span></h2>
        <p>มีลูกค้าใช้บริการอยู่</p>
      </div>
      <button type="button" class="icon-btn plain-button center"
        onclick="closeModal('occupiedTableModal')" aria-label="ปิด">✕</button>
    </div>
    <div class="action-list column">
      <%# ลิงก์ไปตรวจบิลและรับชำระเงินของโต๊ะนี้ %>
      <a id="checkBillBtn" class="action-row row box">
        <span class="center">
          <img src="/images/icons/bill.svg" width="18" height="18" alt="" />
        </span>
        <span><strong>เช็กบิล / รับเงิน</strong> <small>ยอดรวม</small></span>
      </a>
      <%# เปิดใบ QR เดิมเพื่อคัดลอกลิงก์หรือพิมพ์ซ้ำ %>
      <button type="button" class="action-row row box" onclick="showReceiptSlipModal()">
        <span class="center">
          <img src="/images/icons/qr.svg" width="18" height="18" alt="" />
        </span>
        <span><strong>ใบเปิดโต๊ะ / QR ลูกค้า</strong> <small>พิมพ์ซ้ำหรือคัดลอกลิงก์</small></span>
      </button>
      <%# ยกเลิกโต๊ะที่เปิดผิดและยังไม่มีอาหาร %>
      <button type="button" class="action-row danger row box" onclick="resetTableStatus()">
        <span class="center">
          <img src="/images/icons/reset.svg" width="18" height="18" alt="" />
        </span>
        <span>
          <strong>รีเซ็ตเป็นโต๊ะว่าง</strong>
          <small>ใช้เมื่อเปิดโต๊ะผิด ไม่ผ่านการชำระเงิน</small>
        </span>
      </button>
    </div>
  </div>
</dialog>
