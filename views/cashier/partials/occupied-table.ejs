<%# หน้าต่างเลือกดูใบ QR ตรวจบิล หรือคืนโต๊ะ %>
<!-- Occupied table actions -->
<dialog class="modal-overlay row" id="occupiedTableModal" aria-labelledby="occupiedTableModalTitle">
    <div class="modal-content">
        <div class="modal-head">
            <div> <h2 id="occupiedTableModalTitle">โต๊ะ <span id="occTableNo"></span></h2> <p>มีลูกค้าใช้บริการอยู่</p> </div>
            <button type="button" class="icon-btn plain-button center" onclick="closeModal('occupiedTableModal')" aria-label="ปิด">✕</button>
        </div>
        <div class="action-list column">
            <a id="checkBillBtn" class="action-row primary row box">
                <span class="ai center"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 2h10v16l-2.5-1.5L10 18l-2.5-1.5L5 18z"/><path d="M8 7h4M8 10h4"/></svg></span>
                <span><strong>เช็คบิลและรับชำระเงิน</strong><small>สรุปยอดบุฟเฟต์และรายการคิดเงินเพิ่ม</small></span>
            </a>
            <button type="button" class="action-row row box" onclick="showReceiptSlipModal()">
                <span class="ai center"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="5" height="5"/><rect x="12" y="3" width="5" height="5"/><rect x="3" y="12" width="5" height="5"/><path d="M12 12h2v2h-2zM15 15h2v2h-2z"/></svg></span>
                <span><strong>ใบเปิดโต๊ะ / QR ลูกค้า</strong><small>พิมพ์ซ้ำหรือคัดลอกลิงก์</small></span>
            </button>
            <button type="button" class="action-row danger row box" onclick="resetTableStatus()">
                <span class="ai center"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 10a6 6 0 1 0 2-4.5"/><path d="M4 3v3.5h3.5"/></svg></span>
                <span><strong>รีเซ็ตเป็นโต๊ะว่าง</strong><small>ใช้เมื่อเปิดโต๊ะผิด ไม่ผ่านการชำระเงิน</small></span>
            </button>
        </div>
    </div>
</dialog>
