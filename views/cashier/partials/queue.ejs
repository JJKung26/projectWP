<dialog class="modal-overlay row" id="queueModal" aria-labelledby="queueModalTitle">
  <div class="modal-content" style="max-width: 560px;">
    <%# หัวข้อบัตรคิว จำนวนคิวรอ และปุ่มปิด %>
    <div class="modal-head row between">
      <div>
        <h2 id="queueModalTitle">บัตรคิว</h2>
        <p>รอ <span id="waitingCountDisplay">0</span> คิว</p>
      </div>
      <button type="button" class="icon-btn plain-button center" onclick="closeModal('queueModal')"
        aria-label="ปิด">✕</button>
    </div>
    <%# ฟอร์มจำนวนลูกค้าและปุ่มออกบัตรคิวใหม่ %>
    <div class="queue-issue-box">
      <form id="issueQueueForm" onsubmit="submitIssueQueue(event)"
        style="display: flex; gap: 10px; align-items: flex-end;">
        <div style="flex: 1;">
          <label class="form-label" for="newQueueGuestCount">ออกคิวใหม่ · จำนวนลูกค้า</label>
          <div class="flex stepper-input">
            <button class="plain-button" type="button"
              onclick="stepInput('newQueueGuestCount', -1)" aria-label="ลด">−</button>
            <input class="number" type="number" id="newQueueGuestCount" name="guest_count" min="1"
              max="20" value="1" required />
            <button class="plain-button" type="button" onclick="stepInput('newQueueGuestCount', 1)"
              aria-label="เพิ่ม">+</button>
          </div>
        </div>
        <button type="submit" class="btn btn-primary inline-row" style="height: 44px;">
          ออกบัตรคิว
        </button>
      </form>
    </div>
    <div
      style="display: flex; justify-content: space-between;
             align-items: center; margin-bottom: 10px;">
      <h3 style="font-size: 1rem;">คิววันนี้ / ค้นหาคิวเดิม</h3>
      <button class="btn btn-ghost btn-sm inline-row" onclick="loadQueues()">รีเฟรช</button>
    </div>
    <%# เลือกวันที่และเปิดดูคิวทุกสถานะสำหรับพิมพ์ซ้ำ %>
    <div class="flex queue-filters">
      <label>
        วันคิว
        <input id="queueDate" type="date" value="<%= queueDate %>"
          onchange="document.getElementById('queueHistory').checked=true;loadQueues()" />
      </label>
      <label>
        <input id="queueHistory" type="checkbox" onchange="loadQueues()" />
        ดูทุกสถานะเพื่อพิมพ์ซ้ำ
      </label>
    </div>
    <%# พื้นที่ที่ queue.js ใส่รายการคิวจากเซิร์ฟเวอร์ %>
    <div id="queueListContainer" style="display: flex; flex-direction: column; gap: 8px;">
      <div class="text-center empty" style="padding: 24px;">กำลังโหลด…</div>
    </div>
  </div>
</dialog>
