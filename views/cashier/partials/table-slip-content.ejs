<%# คำนวณเวลาเริ่มกับเวลาสิ้นสุด 2 ชั่วโมง และรูปแบบยอดเงิน %>
<%
  const start = new Date(slip.started_at.replace(' ', 'T') + 'Z');
  const end = new Date(start.getTime() + 120 * 60000);
  const adults = slip.guest_count - slip.child_count - slip.free_child_count;
  function amount(value) {
    return Number(value).toLocaleString('th-TH', {
      minimumFractionDigits: 2, maximumFractionDigits: 2
    });
  }
%>
<%# โลโก้ ชื่อร้าน และหมายเลขโต๊ะบนใบ QR %>
<div class="text-center slip-header">
  <%- include('../../partials/shop-logo', { logoClass: 'order-slip-logo' }) %>
  <div class="slip-title">ร้านหมูกระทะ บุฟเฟต์</div>
  <div class="slip-subtitle small">ใบ QR สำหรับสั่งอาหาร</div>
  <h2 class="order-slip-table" tabindex="-1" autofocus>
    หมายเลขโต๊ะ:
    <span><%= slip.table_no %></span>
  </h2>
</div>
<%# จำนวนลูกค้า วันที่ และรหัสรอบบริการ %>
<div class="order-slip-meta small">
  <div class="slip-row">
    <span>จำนวนลูกค้า: <span><%= slip.guest_count %></span> ท่าน</span>
    <span><%= thaiDay(start) %></span>
  </div>
  <div class="slip-row">
    <span>ระยะเวลา: 2 ชั่วโมง</span>
    <span>รอบ: <span><%= slip.session_id.slice(0, 8).toUpperCase() %></span></span>
  </div>
</div>
<div class="text-center order-slip-time digits">
  เริ่มเวลา:
  <strong><%= thaiTime(start) %></strong>
</div>
<%# รูป QR และลิงก์ที่ลูกค้าใช้เปิดเมนู %>
<div class="text-center slip-qr-box">
  <img class="slip-qr-img" src="<%= slip.qr_image %>" alt="QR Code สั่งอาหาร" />
  <div class="slip-qr-caption">สแกน QR Code เพื่อสั่งอาหาร</div>
  <div class="slip-url"><%= slip.customer_url %></div>
</div>
<div class="text-center order-slip-time digits">
  หมดเวลา:
  <strong><%= thaiTime(end) %></strong>
</div>
<div class="text-center order-slip-end-date small">
  <%= thaiDay(start) !== thaiDay(end) ? 'หมดเวลาในวันที่ ' + thaiDay(end) : '' %>
</div>
<%# จำนวนผู้ใหญ่และเด็ก ราคาต่อคน VAT และยอดบุฟเฟต์รวม %>
<div class="slip-details column">
  <div class="slip-row">
    <span>ผู้ใหญ่ <%= adults %> ท่าน</span>
    <strong><%= slip.buffet_price %> บาท/ท่าน</strong>
  </div>
  <div class="slip-row" <% if (!slip.child_count) { %> hidden <% } %>>
    <span>เด็ก 90–120 ซม. <%= slip.child_count %> ท่าน</span>
    <strong><%= slip.child_price %> บาท/ท่าน</strong>
  </div>
  <div class="slip-row" <% if (!slip.free_child_count) { %> hidden <% } %>>
    <span>เด็กต่ำกว่า 90 ซม. <%= slip.free_child_count %> ท่าน</span>
    <strong>ทานฟรี</strong>
  </div>
  <div class="slip-row">
    <span>ยอดบุฟเฟต์ (Subtotal)</span>
    <strong><%= amount(slip.buffet_totals.subtotal) %> บาท</strong>
  </div>
  <div class="slip-row">
    <span>VAT 7%</span>
    <strong><%= amount(slip.buffet_totals.taxAmount) %> บาท</strong>
  </div>
  <div class="slip-row">
    <span>ปัดเศษลง</span>
    <span><%= amount(slip.buffet_totals.roundingAmount) %> บาท</span>
  </div>
  <div class="slip-row total">
    <span>ยอดรวม (รวม VAT)</span>
    <strong><%= amount(slip.buffet_totals.netAmount) %> บาท</strong>
  </div>
</div>
<%# คำอธิบายยอดและข้อความว่าใบ QR ยังไม่ใช่หลักฐานจ่ายเงิน %>
<div class="text-center slip-footer small">
  <div>ยอดนี้รวม VAT 7% แล้ว ไม่รวมรายการที่คิดเพิ่ม</div>
  <div>กรุณานำใบนี้ไปชำระเงินที่แคชเชียร์</div>
  <div>ใบนี้ไม่ใช่หลักฐานการชำระเงิน</div>
</div>
