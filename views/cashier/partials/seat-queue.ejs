<dialog class="modal-overlay row" id="seatQueueModal" aria-labelledby="seatQueueModalTitle">
  <div class="modal-content" style="max-width: 420px;">
    <%# เลขคิว จำนวนลูกค้า และปุ่มปิดฟอร์มจัดโต๊ะ %>
    <div class="modal-head row between">
      <div>
        <h2 id="seatQueueModalTitle">จัดโต๊ะให้คิว <span id="seatQueueNo"></span></h2>
        <p>ลูกค้า <strong id="seatQueueGuests">-</strong> ท่าน</p>
      </div>
      <button type="button" class="icon-btn plain-button center"
        onclick="closeModal('seatQueueModal')" aria-label="ปิด">✕</button>
    </div>
    <form action="/cashier/queue/seat" method="post" onsubmit="submitTable(event)">
      <input type="hidden" id="seatQueueTicketId" name="queue_ticket_id" />
      <%# ตัวเลือกเฉพาะโต๊ะว่าง พร้อมจำนวนที่นั่ง %>
      <fieldset class="form-group seat-table-picker">
        <legend class="form-label row">
          โต๊ะว่าง
          <% if (availableTables.length > 8) { %>
            <small>เลื่อนดูโต๊ะเพิ่มเติม</small>
          <% } %>
        </legend>
        <div class="seat-table-options choices" id="seatTableSelect">
          <% if (availableTables.length === 0) { %>
            <p class="seat-table-empty">ไม่มีโต๊ะว่างตอนนี้</p>
          <% } else { %>
            <%
              for (let index = 0; index < availableTables.length; index++) {
                const at = availableTables[index];
            %>
              <label>
                <input type="radio" name="table_id" value="<%= at.table_id %>" required
                  <%= index === 0 ? 'checked' : '' %> />
                <span>
                  <strong>โต๊ะ <%= at.table_no %></strong>
                  <small><%= at.capacity %> ที่นั่ง</small>
                </span>
              </label>
            <% } %>
          <% } %>
        </div>
      </fieldset>
      <%# กรอกประเภทลูกค้ากับราคา แล้วเปิดโต๊ะให้คิวที่เลือก %>
      <%- include('../../partials/guest-inputs', { guestPrefix: 'seat' }) %>
      <div class="flex modal-actions">
        <button type="button" class="btn btn-secondary inline-row"
          onclick="closeModal('seatQueueModal')">ยกเลิก</button>
        <button type="submit" class="btn btn-primary grow inline-row"
          <%= availableTables.length === 0 ? 'disabled' : '' %>>เปิดโต๊ะให้คิวนี้</button>
      </div>
    </form>
  </div>
</dialog>
