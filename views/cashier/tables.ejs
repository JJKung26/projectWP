<%- include('../partials/header') %>

    <div class="container">
        <div class="page-head">
            <div>
                <div class="eyebrow">แคชเชียร์</div>
                <h1>ผังโต๊ะ</h1>
                <p>แตะโต๊ะว่างเพื่อเปิดโต๊ะและพิมพ์ QR · แตะโต๊ะที่มีลูกค้าเพื่อเช็คบิล</p>
            </div>

            <div style="display: flex; gap: 10px; align-items: stretch; flex-wrap: wrap;">
                <div class="stat-strip">
                    <div class="stat">
                        <div class="stat-label"><span class="dot ok"></span>ว่าง</div>
                        <div class="stat-value"><%= availableCount %></div>
                    </div>
                    <div class="stat">
                        <div class="stat-label"><span class="dot busy"></span>มีลูกค้า</div>
                        <div class="stat-value"><%= occupiedCount %></div>
                    </div>
                    <div class="stat">
                        <div class="stat-label">คิวรอ</div>
                        <div class="stat-value" id="queueBadge"><%= waitingQueues ? waitingQueues.length : 0 %></div>
                    </div>
                </div>
                <button class="btn btn-dark" onclick="openQueueModal()">จัดการคิว</button>
            </div>
        </div>

        <% if (availableCount===0) { %>
            <div class="queue-alert-banner">
                <div>
                    <strong>โต๊ะเต็มทุกโต๊ะ</strong>
                    <div style="font-size: 0.9rem; color: var(--ink-2);">ลูกค้าใหม่ให้ออกบัตรคิวรอไว้ก่อน</div>
                </div>
                <button class="btn btn-primary" onclick="openIssueQueueModal()">ออกบัตรคิว</button>
            </div>
        <% } %>

        <div class="grid-50-tables">
            <% tables.forEach(t=> { const busy = t.table_status === 'OCCUPIED'; %>
                <button type="button" class="table-card <%= t.table_status.toLowerCase() %>" id="table-card-<%= t.table_id %>"
                    onclick="handleTableClick('<%= t.table_id %>', '<%= t.table_no %>', '<%= t.table_status %>', '<%= t.session_id %>', '<%= t.qr_token %>')">
                    <div>
                        <div class="table-label">โต๊ะ</div>
                        <div class="table-number"><%= t.table_no %></div>
                    </div>
                    <div class="table-meta">
                        <% if (busy) { %>
                            <span><%= t.guest_count %> ท่าน</span>
                            <% if (t.started_at) { %>· <span class="elapsed" data-started="<%= t.started_at %>"></span><% } %>
                        <% } else if (t.table_status === 'CLEANING') { %>
                            <span>รอเก็บโต๊ะ</span>
                        <% } else { %>
                            <span><%= t.capacity %> ที่นั่ง</span>
                        <% } %>
                    </div>
                </button>
            <% }); %>
        </div>
    </div>

    <!-- Open table -->
    <div class="modal-overlay" id="openTableModal">
        <div class="modal-content">
            <div class="modal-head">
                <div>
                    <h2>เปิดโต๊ะ <span id="openTableNo"></span></h2>
                    <p>ระบบจะพิมพ์ใบเปิดโต๊ะพร้อม QR ให้อัตโนมัติ</p>
                </div>
                <button type="button" class="icon-btn" onclick="closeModal('openTableModal')" aria-label="ปิด">✕</button>
            </div>
            <form id="openTableForm" onsubmit="submitOpenTable(event)">
                <input type="hidden" id="openTableId" name="table_id">
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="guestCount">จำนวนลูกค้า</label>
                        <div class="stepper-input">
                            <button type="button" onclick="stepInput('guestCount', -1)" aria-label="ลด">−</button>
                            <input type="number" id="guestCount" name="guest_count" min="1" max="20" value="2" required>
                            <button type="button" onclick="stepInput('guestCount', 1)" aria-label="เพิ่ม">+</button>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="buffetPrice">ราคาต่อท่าน (บาท)</label>
                        <input type="number" class="form-input" id="buffetPrice" name="buffet_price" value="279" step="0.01" required>
                    </div>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('openTableModal')">ยกเลิก</button>
                    <button type="submit" class="btn btn-primary grow">เปิดโต๊ะและพิมพ์ QR</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Occupied table actions -->
    <div class="modal-overlay" id="occupiedTableModal">
        <div class="modal-content">
            <div class="modal-head">
                <div>
                    <h2>โต๊ะ <span id="occTableNo"></span></h2>
                    <p>มีลูกค้าใช้บริการอยู่</p>
                </div>
                <button type="button" class="icon-btn" onclick="closeModal('occupiedTableModal')" aria-label="ปิด">✕</button>
            </div>
            <div class="action-list">
                <a id="checkBillBtn" class="action-row primary">
                    <span class="ai"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 2h10v16l-2.5-1.5L10 18l-2.5-1.5L5 18z"/><path d="M8 7h4M8 10h4"/></svg></span>
                    <span><strong>เช็คบิลและรับชำระเงิน</strong><small>สรุปยอดบุฟเฟต์และรายการคิดเงินเพิ่ม</small></span>
                </a>
                <button type="button" class="action-row" onclick="showReceiptSlipModal()">
                    <span class="ai"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="5" height="5"/><rect x="12" y="3" width="5" height="5"/><rect x="3" y="12" width="5" height="5"/><path d="M12 12h2v2h-2zM15 15h2v2h-2z"/></svg></span>
                    <span><strong>ใบเปิดโต๊ะ / QR ลูกค้า</strong><small>พิมพ์ซ้ำหรือคัดลอกลิงก์</small></span>
                </button>
                <button type="button" class="action-row danger" onclick="resetTableStatus()">
                    <span class="ai"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 10a6 6 0 1 0 2-4.5"/><path d="M4 3v3.5h3.5"/></svg></span>
                    <span><strong>รีเซ็ตเป็นโต๊ะว่าง</strong><small>ใช้เมื่อเปิดโต๊ะผิด ไม่ผ่านการชำระเงิน</small></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Open-table slip with customer QR -->
    <div class="modal-overlay" id="slipModal">
        <div class="modal-content" style="max-width: 420px;">
            <div class="receipt-slip print-target" id="slipPrintArea">
                <div class="slip-header">
                    <div class="slip-title">หมูกระทะ บุฟเฟต์</div>
                    <div class="slip-subtitle">ใบเปิดโต๊ะ</div>
                    <div class="slip-table-badge">โต๊ะ <span id="slipTableNo">-</span></div>
                </div>
                <div class="slip-details">
                    <div class="slip-row"><span>เวลาเปิดโต๊ะ</span><strong id="slipStartedAt">-</strong></div>
                    <div class="slip-row"><span>รหัสบริการ</span><span id="slipSessionId" style="font-family: monospace; font-size: 0.8rem;">-</span></div>
                    <div class="slip-row"><span>จำนวนลูกค้า</span><strong><span id="slipGuestCount">-</span> ท่าน</strong></div>
                    <div class="slip-row"><span>ราคาบุฟเฟต์</span><strong><span id="slipBuffetPrice">279</span> บาท/ท่าน</strong></div>
                    <div class="slip-row total"><span>ยอดบุฟเฟต์</span><strong><span id="slipEstTotal">-</span> บาท</strong></div>
                </div>
                <div class="slip-qr-box">
                    <img id="slipQrImg" class="slip-qr-img" src="" alt="QR Code สั่งอาหาร">
                    <div class="slip-qr-caption">สแกนเพื่อสั่งอาหารจากมือถือ</div>
                    <div class="slip-url" id="slipUrlText">-</div>
                </div>
                <div class="slip-footer">
                    <div>ทานได้ไม่อั้นตามเวลาที่ร้านกำหนด · ทานเหลือมีค่าปรับ</div>
                    <div style="margin-top: 2px;">ขอบคุณที่ใช้บริการ</div>
                </div>
            </div>
            <div class="no-print modal-actions">
                <button class="btn btn-secondary" onclick="copySlipUrl()">คัดลอกลิงก์</button>
                <button class="btn btn-secondary" onclick="printSlip()">พิมพ์</button>
                <button class="btn btn-dark grow" onclick="closeModal('slipModal')">เสร็จ</button>
            </div>
        </div>
    </div>

    <!-- Queue management -->
    <div class="modal-overlay" id="queueModal">
        <div class="modal-content" style="max-width: 560px;">
            <div class="modal-head">
                <div>
                    <h2>บัตรคิว</h2>
                    <p>รอ <span id="waitingCountDisplay">0</span> คิว</p>
                </div>
                <button type="button" class="icon-btn" onclick="closeModal('queueModal')" aria-label="ปิด">✕</button>
            </div>

            <div class="queue-issue-box">
                <form id="issueQueueForm" onsubmit="submitIssueQueue(event)" style="display: flex; gap: 10px; align-items: flex-end;">
                    <div style="flex: 1;">
                        <label class="form-label" for="newQueueGuestCount">ออกคิวใหม่ · จำนวนลูกค้า</label>
                        <div class="stepper-input">
                            <button type="button" onclick="stepInput('newQueueGuestCount', -1)" aria-label="ลด">−</button>
                            <input type="number" id="newQueueGuestCount" min="1" max="20" value="2" required>
                            <button type="button" onclick="stepInput('newQueueGuestCount', 1)" aria-label="เพิ่ม">+</button>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary" style="height: 44px;">ออกบัตรคิว</button>
                </form>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <h3 style="font-size: 1rem;">คิวที่รออยู่</h3>
                <button class="btn btn-ghost btn-sm" onclick="loadQueues()">รีเฟรช</button>
            </div>
            <div id="queueListContainer" style="display: flex; flex-direction: column; gap: 8px;">
                <div class="empty" style="padding: 24px;">กำลังโหลด…</div>
            </div>
        </div>
    </div>

    <!-- Queue ticket slip -->
    <div class="modal-overlay" id="queueSlipModal">
        <div class="modal-content" style="max-width: 380px;">
            <div class="receipt-slip print-target" id="queueSlipPrintArea">
                <div class="slip-header">
                    <div class="slip-title">หมูกระทะ บุฟเฟต์</div>
                    <div class="slip-subtitle">บัตรคิว</div>
                    <div class="slip-table-badge" id="qsQueueNo" style="font-size: 3rem;">-</div>
                </div>
                <div class="slip-details">
                    <div class="slip-row"><span>วันที่</span><strong id="qsDate">-</strong></div>
                    <div class="slip-row"><span>เวลาออกคิว</span><strong id="qsTime">-</strong></div>
                    <div class="slip-row"><span>จำนวนลูกค้า</span><strong><span id="qsGuests">-</span> ท่าน</strong></div>
                    <div class="slip-row total"><span>คิวก่อนหน้า</span><strong><span id="qsAhead">-</span> คิว</strong></div>
                </div>
                <div class="slip-footer">
                    <div>กรุณารอพนักงานเรียกหมายเลขคิว</div>
                    <div style="margin-top: 2px;">ขอบคุณที่รอ</div>
                </div>
            </div>
            <div class="no-print modal-actions">
                <button class="btn btn-secondary" onclick="printSlip()">พิมพ์</button>
                <button class="btn btn-dark grow" onclick="closeModal('queueSlipModal')">เสร็จ</button>
            </div>
        </div>
    </div>

    <!-- Seat a queue ticket at a free table -->
    <div class="modal-overlay" id="seatQueueModal">
        <div class="modal-content" style="max-width: 420px;">
            <div class="modal-head">
                <div>
                    <h2>จัดโต๊ะให้คิว <span id="seatQueueNo"></span></h2>
                    <p>ลูกค้า <strong id="seatQueueGuests">-</strong> ท่าน</p>
                </div>
                <button type="button" class="icon-btn" onclick="closeModal('seatQueueModal')" aria-label="ปิด">✕</button>
            </div>
            <form onsubmit="submitSeatQueue(event)">
                <input type="hidden" id="seatQueueTicketId">
                <div class="form-group">
                    <label class="form-label" for="seatTableSelect">โต๊ะว่าง</label>
                    <select class="form-select" id="seatTableSelect" required>
                        <% const availTables=tables.filter(t=> t.table_status === 'AVAILABLE'); %>
                        <% if (availTables.length===0) { %>
                            <option value="">ไม่มีโต๊ะว่างตอนนี้</option>
                        <% } else { %>
                            <% availTables.forEach(at=> { %>
                                <option value="<%= at.table_id %>">โต๊ะ <%= at.table_no %> · <%= at.capacity %> ที่นั่ง</option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="seatBuffetPrice">ราคาต่อท่าน (บาท)</label>
                    <input type="number" class="form-input" id="seatBuffetPrice" value="279" step="0.01" required>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('seatQueueModal')">ยกเลิก</button>
                    <button type="submit" class="btn btn-primary grow" <%= availTables.length === 0 ? 'disabled' : '' %>>เปิดโต๊ะให้คิวนี้</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Audio for Queue Calling chime -->
    <audio id="queueChime" preload="auto">
        <source src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" type="audio/mpeg">
    </audio>

    <script>
        const socket = io();
        let selectedTable = {};
        let currentCustomerUrl = '';

        // Click handler on table card
        function handleTableClick(tableId, tableNo, status, sessionId, qrToken) {
            selectedTable = { tableId, tableNo, status, sessionId, qrToken };
            if (status === 'AVAILABLE') {
                document.getElementById('openTableId').value = tableId;
                document.getElementById('openTableNo').innerText = tableNo;
                document.getElementById('guestCount').value = 2;
                document.getElementById('buffetPrice').value = 279;
                openModal('openTableModal');
            } else if (status === 'OCCUPIED') {
                document.getElementById('occTableNo').innerText = tableNo;
                document.getElementById('checkBillBtn').href = `/cashier/bill/${sessionId}`;
                openModal('occupiedTableModal');
            }
        }

        // Auto-fill guests when choosing queue in open table
        function onSelectQueueForTable(queueTicketId) {
            if (!queueTicketId) return;
            const select = document.getElementById('openQueueSelect');
            const selectedOpt = select.options[select.selectedIndex];
            const guests = selectedOpt.getAttribute('data-guests');
            if (guests) {
                document.getElementById('guestCount').value = guests;
            }
        }

        // Submit open table form
        async function submitOpenTable(e) {
            e.preventDefault();
            const table_id = document.getElementById('openTableId').value;
            const guest_count = document.getElementById('guestCount').value;
            const buffet_price = document.getElementById('buffetPrice').value;

            try {
                const res = await fetch('/cashier/open-table', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ table_id, guest_count, buffet_price })
                });
                const data = await res.json();
                if (data.success) {
                    closeModal('openTableModal');
                    // Populate slip details immediately
                    displaySlipData({
                        table_no: data.table_no,
                        session_id: data.session_id,
                        guest_count: data.guest_count,
                        buffet_price: data.buffet_price,
                        started_at: data.started_at,
                        customer_url: data.customer_url,
                        qr_image: data.qr_image
                    });
                    openModal('slipModal');
                    setTimeout(() => {
                        printSlip();
                    }, 300);
                } else {
                    alert(data.message || 'เกิดข้อผิดพลาดในการเปิดโต๊ะ');
                }
            } catch (err) {
                alert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์');
            }
        }

        // Show slip modal for occupied table
        async function showReceiptSlipModal() {
            closeModal('occupiedTableModal');
            try {
                const res = await fetch(`/cashier/qr/${selectedTable.qrToken}`);
                const data = await res.json();
                if (data.success) {
                    displaySlipData(data);
                    openModal('slipModal');
                } else {
                    alert(data.message || 'ไม่สามารถโหลดข้อมูลโต๊ะได้');
                }
            } catch (err) {
                alert('ไม่สามารถโหลดข้อมูลใบเปิดโต๊ะได้');
            }
        }

        // Populate Slip Modal fields
        function displaySlipData(data) {
            document.getElementById('slipTableNo').innerText = data.table_no;
            document.getElementById('slipStartedAt').innerText = data.started_at;
            document.getElementById('slipSessionId').innerText = data.session_id;
            document.getElementById('slipGuestCount').innerText = data.guest_count;
            document.getElementById('slipBuffetPrice').innerText = data.buffet_price;
            const estTotal = (parseFloat(data.guest_count) || 0) * (parseFloat(data.buffet_price) || 0);
            document.getElementById('slipEstTotal').innerText = estTotal.toLocaleString();
            document.getElementById('slipQrImg').src = data.qr_image;
            document.getElementById('slipUrlText').innerText = data.customer_url;
            currentCustomerUrl = data.customer_url;
        }

        // Print Receipt Slip
        function printSlip() {
            window.print();
        }

        // Copy URL to clipboard
        function copySlipUrl() {
            if (!currentCustomerUrl) return;
            navigator.clipboard.writeText(currentCustomerUrl).then(() => {
                alert('คัดลอกลิงก์เรียบร้อยแล้ว: ' + currentCustomerUrl);
            }).catch(() => {
                prompt('คัดลอกลิงก์:', currentCustomerUrl);
            });
        }

        // Reset Table Status
        async function resetTableStatus() {
            if (!confirm(`ยืนยันการรีเซ็ตโต๊ะ ${selectedTable.tableNo} เป็นว่างหรือไม่?`)) return;
            try {
                const res = await fetch('/cashier/reset-table', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ table_id: selectedTable.tableId })
                });
                const data = await res.json();
                if (data.success) {
                    closeModal('occupiedTableModal');
                    location.reload();
                }
            } catch (err) {
                alert('เกิดข้อผิดพลาดในการรีเซ็ตโต๊ะ');
            }
        }

        // =========================================================================
        // Queue Management Functions
        // =========================================================================
        function openQueueModal() {
            loadQueues();
            openModal('queueModal');
        }

        function openIssueQueueModal() {
            openModal('queueModal');
            document.getElementById('newQueueGuestCount').focus();
        }

        async function loadQueues() {
            const container = document.getElementById('queueListContainer');
            container.innerHTML = '<div class="empty" style="padding: 24px;">กำลังโหลด…</div>';

            try {
                const res = await fetch('/cashier/queue/list');
                const data = await res.json();
                if (data.success) {
                    document.getElementById('waitingCountDisplay').innerText = data.totalWaiting;
                    const badge = document.getElementById('queueBadge');
                    if (badge) badge.innerText = data.totalWaiting;

                    if (data.queues.length === 0) {
                        container.innerHTML = '<div class="empty" style="padding: 28px;">ยังไม่มีคิวรอ</div>';
                        return;
                    }

                    let html = '';
                    data.queues.forEach(q => {
                        const isCalled = q.queue_status === 'CALLED';
                        html += `
                        <div class="queue-card-item${isCalled ? ' called' : ''}">
                            <div style="display: flex; align-items: center; gap: 14px;">
                                <div class="queue-no-badge">${q.queue_no}</div>
                                <div>
                                    <div style="font-weight: 500;">${q.guest_count} ท่าน</div>
                                    <div style="font-size: 0.8rem; color: var(--ink-3);">${isCalled ? 'เรียกแล้ว รอลูกค้ามา' : 'รอเรียก'}</div>
                                </div>
                            </div>
                            <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                <button class="btn btn-secondary btn-sm" onclick="callQueue('${q.queue_ticket_id}')">เรียกคิว</button>
                                <button class="btn btn-dark btn-sm" onclick="openSeatModal('${q.queue_ticket_id}', '${q.queue_no}', ${q.guest_count})">จัดโต๊ะ</button>
                                <button class="btn btn-ghost btn-sm" style="color: var(--danger);" onclick="cancelQueue('${q.queue_ticket_id}')">ยกเลิก</button>
                            </div>
                        </div>
                    `;
                    });
                    container.innerHTML = html;
                }
            } catch (err) {
                container.innerHTML = '<div class="empty" style="padding: 24px; color: var(--danger);">โหลดคิวไม่สำเร็จ</div>';
            }
        }

        async function submitIssueQueue(e) {
            e.preventDefault();
            const guest_count = document.getElementById('newQueueGuestCount').value;

            try {
                const res = await fetch('/cashier/queue/issue', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ guest_count })
                });
                const data = await res.json();
                if (data.success) {
                    // Show Queue Ticket Slip
                    document.getElementById('qsQueueNo').innerText = data.ticket.queue_no;
                    document.getElementById('qsDate').innerText = data.ticket.queue_date;
                    document.getElementById('qsTime').innerText = data.ticket.created_at;
                    document.getElementById('qsGuests').innerText = data.ticket.guest_count;
                    document.getElementById('qsAhead').innerText = data.ticket.count_ahead;

                    closeModal('queueModal');
                    openModal('queueSlipModal');
                    setTimeout(() => {
                        printSlip();
                    }, 300);
                    loadQueues();
                } else {
                    alert(data.message || 'เกิดข้อผิดพลาดในการออกคิว');
                }
            } catch (err) {
                alert('เกิดข้อผิดพลาดในการออกบัตรคิว');
            }
        }

        async function callQueue(queue_ticket_id) {
            try {
                const res = await fetch('/cashier/queue/call', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ queue_ticket_id })
                });
                const data = await res.json();
                if (data.success) {
                    playChime();
                    alert(`เรียกคิว ${data.queue_no} แล้ว`);
                    loadQueues();
                }
            } catch (err) {
                alert('เกิดข้อผิดพลาดในการเรียกคิว');
            }
        }

        function openSeatModal(queue_ticket_id, queue_no, guest_count) {
            document.getElementById('seatQueueTicketId').value = queue_ticket_id;
            document.getElementById('seatQueueNo').innerText = queue_no;
            document.getElementById('seatQueueGuests').innerText = guest_count;
            closeModal('queueModal');
            openModal('seatQueueModal');
        }

        async function submitSeatQueue(e) {
            e.preventDefault();
            const queue_ticket_id = document.getElementById('seatQueueTicketId').value;
            const table_id = document.getElementById('seatTableSelect').value;
            const buffet_price = document.getElementById('seatBuffetPrice').value;

            if (!table_id) {
                alert('กรุณาเลือกโต๊ะว่าง');
                return;
            }

            try {
                const res = await fetch('/cashier/queue/seat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ queue_ticket_id, table_id, buffet_price })
                });
                const data = await res.json();
                if (data.success) {
                    closeModal('seatQueueModal');
                    displaySlipData(data);
                    openModal('slipModal');
                    setTimeout(() => {
                        printSlip();
                    }, 300);
                } else {
                    alert(data.message || 'ไม่สามารถจัดคิวเข้าโต๊ะได้');
                }
            } catch (err) {
                alert('เกิดข้อผิดพลาดในการจัดคิวเข้าโต๊ะ');
            }
        }

        async function cancelQueue(queue_ticket_id) {
            if (!confirm('ยืนยันการยกเลิกบัตรคิวนี้หรือไม่?')) return;
            try {
                const res = await fetch('/cashier/queue/cancel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ queue_ticket_id })
                });
                const data = await res.json();
                if (data.success) {
                    loadQueues();
                }
            } catch (err) {
                alert('เกิดข้อผิดพลาดในการยกเลิกคิว');
            }
        }

        function playChime() {
            const chime = document.getElementById('queueChime');
            if (chime) {
                chime.play().catch(() => { });
            }
        }

        function stepInput(id, delta) {
            const el = document.getElementById(id);
            const next = (parseInt(el.value, 10) || 0) + delta;
            el.value = Math.min(parseInt(el.max, 10) || 99, Math.max(parseInt(el.min, 10) || 1, next));
        }

        // started_at is stored as UTC by SQLite CURRENT_TIMESTAMP
        function renderElapsed() {
            document.querySelectorAll('.elapsed').forEach(el => {
                const started = new Date(el.dataset.started.replace(' ', 'T') + 'Z');
                const mins = Math.max(0, Math.floor((Date.now() - started) / 60000));
                el.textContent = mins < 60 ? `${mins} นาที`
                    : mins < 1440 ? `${Math.floor(mins / 60)}:${String(mins % 60).padStart(2, '0')} ชม.`
                    : `${Math.floor(mins / 1440)} วัน`;
            });
        }
        renderElapsed();
        setInterval(renderElapsed, 30000);

        // Modal Helpers
        function openModal(id) { document.getElementById(id).classList.add('active'); }
        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
            if (id === 'slipModal') {
                location.reload();
            }
        }

        // Socket.IO Listeners
        socket.on('table-status-changed', () => {
            // Keep UI synced
            const isSlipOpen = document.getElementById('slipModal').classList.contains('active');
            const isQueueSlipOpen = document.getElementById('queueSlipModal').classList.contains('active');
            if (!isSlipOpen && !isQueueSlipOpen) {
                location.reload();
            }
        });

        socket.on('queue-updated', () => {
            loadQueues();
        });

        socket.on('queue-called', (data) => {
            playChime();
        });
    </script>

