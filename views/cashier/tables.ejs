<%- include('../partials/header') %>
<div class="container">
  <%# หัวข้อผังโต๊ะ จำนวนโต๊ะว่าง มีลูกค้า และคิวรอ %>
  <div class="page-head row between wrap">
    <div>
      <div class="small muted">แคชเชียร์</div>
      <h1>ผังโต๊ะ</h1>
      <p>แตะโต๊ะว่างเพื่อเปิดโต๊ะและดู QR · แตะโต๊ะที่มีลูกค้าเพื่อเช็คบิล</p>
    </div>
    <div style="display: flex; gap: 10px; align-items: stretch; flex-wrap: wrap;">
      <div class="flex stat-strip box">
        <div class="stat">
          <div class="stat-label row small muted">
            <span class="dot ok"></span>
            ว่าง
          </div>
          <div class="stat-value number digits large"><%= availableCount %></div>
        </div>
        <div class="stat">
          <div class="stat-label row small muted">
            <span class="dot"></span>
            มีลูกค้า
          </div>
          <div class="stat-value number digits large"><%= occupiedCount %></div>
        </div>
        <div class="stat">
          <div class="stat-label row small muted">คิวรอ</div>
          <div class="stat-value number digits large"
            id="queueBadge"><%= waitingQueues.length %></div>
        </div>
      </div>
      <a class="btn inline-row" href="/cashier/receipts">ใบเสร็จย้อนหลัง</a>
      <button class="btn btn-primary inline-row" onclick="openQueueModal()">จัดการคิว</button>
    </div>
  </div>
  <%# แจ้งโต๊ะเต็มและแสดงปุ่มออกบัตรคิว %>
  <div id="tableAlert">
    <% if (availableCount === 0) { %>
      <div class="queue-alert-banner row between">
        <div>
          <strong>โต๊ะเต็มทุกโต๊ะ</strong>
          <div class="small muted">
            ลูกค้าใหม่ให้ออกบัตรคิวรอไว้ก่อน
          </div>
        </div>
        <button class="btn btn-primary inline-row" onclick="openIssueQueueModal()">
          ออกบัตรคิว
        </button>
      </div>
    <% } %>
  </div>
  <%# การ์ดแต่ละโต๊ะ แสดงจำนวนคนและเวลาหรือจำนวนที่นั่ง %>
  <div class="grid-50-tables">
    <%
      for (const t of tables) {
        const busy = t.table_status === 'OCCUPIED';
    %>
      <button type="button" class="table-card <%= t.table_status.toLowerCase() %> column box"
        id="table-card-<%= t.table_id %>"
        onclick="handleTableClick(
          '<%= t.table_id %>', '<%= t.table_no %>', '<%= t.table_status %>',
          '<%= t.session_id %>', '<%= t.qr_token %>'
        )">
        <div>
          <div class="table-label small muted">โต๊ะ</div>
          <div class="table-number number digits large"><%= t.table_no %></div>
        </div>
        <div class="table-meta row small muted">
          <% if (busy) { %>
            <span><%= t.guest_count %> ท่าน</span>
            <span class="elapsed" data-started="<%= t.started_at %>"
              title="เวลาที่ใช้ (ชั่วโมง:นาที)"></span>
          <% } else { %>
            <span><%= t.capacity %> ที่นั่ง</span>
          <% } %>
        </div>
      </button>
    <% } %>
  </div>
</div>
<%# ป๊อปอัปเปิดโต๊ะ ใบ QR และจัดการคิว %>
<%- include('partials/open-table') %>
<%- include('partials/occupied-table') %>
<%- include('partials/table-slip') %>
<%- include('partials/queue') %>
<%- include('partials/queue-slip') %>
<%- include('partials/seat-queue') %>
<%# ข้อความเรียกคิว และโหลด JavaScript จัดโต๊ะกับคิว %>
<p id="queueNotice" role="status" class="container"></p>
<script src="/js/queue-voice.js"></script>
<script src="/js/cashier.js"></script>
<script src="/js/queue.js"></script>
<%- include('../partials/footer') %>
