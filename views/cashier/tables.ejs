<%- include('../partials/header') %>

    <div class="container">
        <div class="page-head">
            <% if (urlError) { %><p role="alert" class="configuration-error"><%= urlError %></p><% } %>
            <div>
                <div class="eyebrow">แคชเชียร์</div>
                <h1>ผังโต๊ะ</h1>
                <p>แตะโต๊ะว่างเพื่อเปิดโต๊ะและดู QR · แตะโต๊ะที่มีลูกค้าเพื่อเช็คบิล</p>
            </div>

            <div style="display: flex; gap: 10px; align-items: stretch; flex-wrap: wrap;">
                <div class="stat-strip">
                    <div class="stat">
                        <div class="stat-label"><span class="dot ok"></span>ว่าง</div>
                        <div class="stat-value"><%= availableCount %></div>
                    </div>
                    <div class="stat">
                        <div class="stat-label"><span class="dot busy"></span>มีลูกค้า</div>
                        <div class="stat-value"><%= occupiedCount %></div>
                    </div>
                    <div class="stat">
                        <div class="stat-label">คิวรอ</div>
                        <div class="stat-value" id="queueBadge"><%= waitingQueues ? waitingQueues.length : 0 %></div>
                    </div>
                </div>
                <a class="btn btn-secondary" href="/cashier/receipts">ใบเสร็จย้อนหลัง</a>
                <button class="btn btn-dark" onclick="openQueueModal()">จัดการคิว</button>
            </div>
        </div>

        <div id="tableAlert">
        <% if (availableCount===0) { %>
            <div class="queue-alert-banner">
                <div>
                    <strong>โต๊ะเต็มทุกโต๊ะ</strong>
                    <div style="font-size: 0.9rem; color: var(--ink-2);">ลูกค้าใหม่ให้ออกบัตรคิวรอไว้ก่อน</div>
                </div>
                <button class="btn btn-primary" onclick="openIssueQueueModal()">ออกบัตรคิว</button>
            </div>
        <% } %>

        </div>
        <div class="grid-50-tables">
            <% tables.forEach(t=> { const busy = t.table_status === 'OCCUPIED'; %>
                <button type="button" class="table-card <%= t.table_status.toLowerCase() %>" id="table-card-<%= t.table_id %>"
                    onclick="handleTableClick('<%= t.table_id %>', '<%= t.table_no %>', '<%= t.table_status %>', '<%= t.session_id %>', '<%= t.qr_token %>')">
                    <div>
                        <div class="table-label">โต๊ะ</div>
                        <div class="table-number"><%= t.table_no %></div>
                    </div>
                    <div class="table-meta">
                        <% if (busy) { %>
                            <span><%= t.guest_count %> ท่าน</span>
                            <% if (t.started_at) { %>· <span class="elapsed" data-started="<%= t.started_at %>"></span><% } %>
                        <% } else { %>
                            <span><%= t.capacity %> ที่นั่ง</span>
                        <% } %>
                    </div>
                </button>
            <% }); %>
        </div>
    </div>

    <!-- Open table -->
    <div class="modal-overlay" id="openTableModal">
        <div class="modal-content">
            <div class="modal-head">
                <div>
                    <h2>เปิดโต๊ะ <span id="openTableNo"></span></h2>
                    <p>เปิดใบ QR แล้วกดพิมพ์ได้ตามต้องการ</p>
                </div>
                <button type="button" class="icon-btn" onclick="closeModal('openTableModal')" aria-label="ปิด">✕</button>
            </div>
            <form id="openTableForm" onsubmit="submitOpenTable(event)">
                <input type="hidden" id="openTableId" name="table_id">
                <%- include('../partials/guest-inputs', { guestPrefix: 'open', priceId: 'buffetPrice' }) %>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('openTableModal')">ยกเลิก</button>
                    <button type="submit" class="btn btn-primary grow">เปิดโต๊ะและดู QR</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Occupied table actions -->
    <div class="modal-overlay" id="occupiedTableModal">
        <div class="modal-content">
            <div class="modal-head">
                <div>
                    <h2>โต๊ะ <span id="occTableNo"></span></h2>
                    <p>มีลูกค้าใช้บริการอยู่</p>
                </div>
                <button type="button" class="icon-btn" onclick="closeModal('occupiedTableModal')" aria-label="ปิด">✕</button>
            </div>
            <div class="action-list">
                <a id="checkBillBtn" class="action-row primary">
                    <span class="ai"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 2h10v16l-2.5-1.5L10 18l-2.5-1.5L5 18z"/><path d="M8 7h4M8 10h4"/></svg></span>
                    <span><strong>เช็คบิลและรับชำระเงิน</strong><small>สรุปยอดบุฟเฟต์และรายการคิดเงินเพิ่ม</small></span>
                </a>
                <button type="button" class="action-row" onclick="showReceiptSlipModal()">
                    <span class="ai"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="5" height="5"/><rect x="12" y="3" width="5" height="5"/><rect x="3" y="12" width="5" height="5"/><path d="M12 12h2v2h-2zM15 15h2v2h-2z"/></svg></span>
                    <span><strong>ใบเปิดโต๊ะ / QR ลูกค้า</strong><small>พิมพ์ซ้ำหรือคัดลอกลิงก์</small></span>
                </button>
                <button type="button" class="action-row danger" onclick="resetTableStatus()">
                    <span class="ai"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 10a6 6 0 1 0 2-4.5"/><path d="M4 3v3.5h3.5"/></svg></span>
                    <span><strong>รีเซ็ตเป็นโต๊ะว่าง</strong><small>ใช้เมื่อเปิดโต๊ะผิด ไม่ผ่านการชำระเงิน</small></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Open-table slip with customer QR -->
    <div class="modal-overlay" id="slipModal">
        <div class="modal-content" style="max-width: 420px;">
            <div class="receipt-slip order-slip print-target" id="slipPrintArea">
                <div class="slip-header">
                    <%- include('../partials/shop-logo', { logoClass: 'order-slip-logo' }) %>
                    <div class="slip-title">ร้านหมูกระทะ บุฟเฟต์</div>
                    <div class="slip-subtitle">ใบ QR สำหรับสั่งอาหาร</div>
                    <h2 class="order-slip-table" tabindex="-1" data-dialog-focus>หมายเลขโต๊ะ: <span id="slipTableNo">-</span></h2>
                </div>
                <div class="order-slip-meta">
                    <div class="slip-row"><span>จำนวนลูกค้า: <span id="slipGuestCount">-</span> ท่าน</span><span id="slipStartedAt">-</span></div>
                    <div class="slip-row"><span>ระยะเวลา: 2 ชั่วโมง</span><span>รอบ: <span id="slipSessionId">-</span></span></div>
                </div>
                <div class="order-slip-time">เริ่มเวลา: <strong id="slipStartTime">--:--</strong></div>
                <div class="slip-qr-box">
                    <img id="slipQrImg" class="slip-qr-img" src="" alt="QR Code สั่งอาหาร">
                    <div class="slip-qr-caption">สแกน QR Code เพื่อสั่งอาหาร</div>
                    <div class="slip-url" id="slipUrlText">-</div>
                </div>
                <div class="order-slip-time">หมดเวลา: <strong id="slipEndTime">--:--</strong></div>
                <div class="order-slip-end-date" id="slipEndDate"></div>
                <div class="slip-details">
                    <div class="slip-row"><span>ผู้ใหญ่ <span id="slipAdultCount">-</span> ท่าน</span><strong><span id="slipBuffetPrice">279</span> บาท/ท่าน</strong></div>
                    <div class="slip-row" id="slipChildRow"><span>เด็ก 90–120 ซม. <span id="slipChildCount">0</span> ท่าน</span><strong><span id="slipChildPrice">179</span> บาท/ท่าน</strong></div>
                    <div class="slip-row" id="slipFreeChildRow"><span>เด็กต่ำกว่า 90 ซม. <span id="slipFreeChildCount">0</span> ท่าน</span><strong>ทานฟรี</strong></div>
                    <div class="slip-row"><span>ยอดบุฟเฟต์ (Subtotal)</span><strong><span id="slipEstTotal">-</span> บาท</strong></div>
                    <div class="slip-row"><span>VAT 7%</span><strong><span id="slipVat">-</span> บาท</strong></div>
                    <div class="slip-row"><span>ปัดเศษลง</span><span><span id="slipRounding">-</span> บาท</span></div>
                    <div class="slip-row total"><span>ยอดรวม (รวม VAT)</span><strong><span id="slipGrandTotal">-</span> บาท</strong></div>
                </div>
                <div class="slip-footer">
                    <div>ยอดนี้รวม VAT 7% แล้ว ไม่รวมรายการที่คิดเพิ่ม</div>
                    <div>กรุณานำใบนี้ไปชำระเงินที่แคชเชียร์</div>
                    <div class="order-slip-note">ใบนี้ไม่ใช่หลักฐานการชำระเงิน</div>
                </div>
            </div>
            <div class="no-print modal-actions">
                <button class="btn btn-secondary" onclick="copySlipUrl()">คัดลอกลิงก์</button>
                <%- include('../partials/paper', { paperId: 'qr-paper', defaultPaper: '80' }) %>
                <button class="btn btn-secondary" onclick="printSlip()">พิมพ์</button>
                <button class="btn btn-dark grow" onclick="closeModal('slipModal')">เสร็จ</button>
            </div>
        </div>
    </div>

    <!-- Queue management -->
    <div class="modal-overlay" id="queueModal">
        <div class="modal-content" style="max-width: 560px;">
            <div class="modal-head">
                <div>
                    <h2>บัตรคิว</h2>
                    <p>รอ <span id="waitingCountDisplay">0</span> คิว</p>
                </div>
                <button type="button" class="icon-btn" onclick="closeModal('queueModal')" aria-label="ปิด">✕</button>
            </div>

            <div class="queue-issue-box">
                <form id="issueQueueForm" onsubmit="submitIssueQueue(event)" style="display: flex; gap: 10px; align-items: flex-end;">
                    <div style="flex: 1;">
                        <label class="form-label" for="newQueueGuestCount">ออกคิวใหม่ · จำนวนลูกค้า</label>
                        <div class="stepper-input">
                            <button type="button" onclick="stepInput('newQueueGuestCount', -1)" aria-label="ลด">−</button>
                            <input type="number" id="newQueueGuestCount" min="1" max="20" value="1" required>
                            <button type="button" onclick="stepInput('newQueueGuestCount', 1)" aria-label="เพิ่ม">+</button>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary" style="height: 44px;">ออกบัตรคิว</button>
                </form>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <h3 style="font-size: 1rem;">คิววันนี้ / ค้นหาคิวเดิม</h3>
                <button class="btn btn-ghost btn-sm" onclick="loadQueues()">รีเฟรช</button>
            </div>
            <div class="queue-filters">
                <label>วันคิว <input id="queueDate" type="date" value="<%= queueDate %>" onchange="document.getElementById('queueHistory').checked=true;loadQueues()"></label>
                <label><input id="queueHistory" type="checkbox" onchange="loadQueues()"> ดูทุกสถานะเพื่อพิมพ์ซ้ำ</label>
            </div>
            <div id="queueListContainer" style="display: flex; flex-direction: column; gap: 8px;">
                <div class="empty" style="padding: 24px;">กำลังโหลด…</div>
            </div>
        </div>
    </div>

    <!-- Queue ticket slip -->
    <div class="modal-overlay" id="queueSlipModal">
        <div class="modal-content" style="max-width: 380px;">
            <div class="receipt-slip print-target" id="queueSlipPrintArea">
                <div class="slip-header">
                    <%- include('../partials/shop-logo', { logoClass: 'order-slip-logo' }) %>
                    <div class="slip-title">หมูกระทะ บุฟเฟต์</div>
                    <div class="slip-subtitle">บัตรคิว</div>
                    <div class="slip-table-badge" id="qsQueueNo" style="font-size: 3rem;">-</div>
                </div>
                <div class="slip-details">
                    <div class="slip-row"><span>วันที่</span><strong id="qsDate">-</strong></div>
                    <div class="slip-row"><span>เวลาออกคิว</span><strong id="qsTime">-</strong></div>
                    <div class="slip-row"><span>จำนวนลูกค้า</span><strong><span id="qsGuests">-</span> ท่าน</strong></div>
                    <div class="slip-row total"><span>คิวก่อนหน้า</span><strong><span id="qsAhead">-</span> คิว</strong></div>
                </div>
                <div class="slip-footer">
                    <div>กรุณารอพนักงานเรียกหมายเลขคิว</div>
                    <div style="margin-top: 2px;">ขอบคุณที่รอ</div>
                </div>
            </div>
            <div class="no-print modal-actions">
                <%- include('../partials/paper', { paperId: 'queue-paper', defaultPaper: '80' }) %>
                <button class="btn btn-secondary" onclick="printSlip()">พิมพ์</button>
                <button class="btn btn-dark grow" onclick="closeModal('queueSlipModal')">เสร็จ</button>
            </div>
        </div>
    </div>

    <!-- Seat a queue ticket at a free table -->
    <div class="modal-overlay" id="seatQueueModal">
        <div class="modal-content" style="max-width: 420px;">
            <div class="modal-head">
                <div>
                    <h2>จัดโต๊ะให้คิว <span id="seatQueueNo"></span></h2>
                    <p>ลูกค้า <strong id="seatQueueGuests">-</strong> ท่าน</p>
                </div>
                <button type="button" class="icon-btn" onclick="closeModal('seatQueueModal')" aria-label="ปิด">✕</button>
            </div>
            <form onsubmit="submitSeatQueue(event)">
                <input type="hidden" id="seatQueueTicketId">
                <% const availTables=tables.filter(t=> t.table_status === 'AVAILABLE'); %>
                <fieldset class="form-group seat-table-picker">
                    <legend class="form-label">โต๊ะว่าง <% if (availTables.length > 8) { %><small>เลื่อนดูโต๊ะเพิ่มเติม</small><% } %></legend>
                    <div class="seat-table-options" id="seatTableSelect">
                        <% if (availTables.length===0) { %>
                            <p class="seat-table-empty">ไม่มีโต๊ะว่างตอนนี้</p>
                        <% } else { %>
                            <% availTables.forEach((at, index)=> { %>
                                <label>
                                    <input type="radio" name="seat_table" value="<%= at.table_id %>" required <%= index === 0 ? 'checked' : '' %>>
                                    <span><strong>โต๊ะ <%= at.table_no %></strong><small><%= at.capacity %> ที่นั่ง</small></span>
                                </label>
                            <% }); %>
                        <% } %>
                    </div>
                </fieldset>
                <%- include('../partials/guest-inputs', { guestPrefix: 'seat', priceId: 'seatBuffetPrice' }) %>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('seatQueueModal')">ยกเลิก</button>
                    <button type="submit" class="btn btn-primary grow" <%= availTables.length === 0 ? 'disabled' : '' %>>เปิดโต๊ะให้คิวนี้</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Audio for Queue Calling chime -->
    <p id="queueNotice" role="status" class="container"></p>

    <script src="/js/queue-voice.js?v=female-1"></script>
    <script>
        const socket = io({auth:{role:'CASHIER'}});
        const refreshTables = liveRegion(socket, ['.grid-50-tables','.stat-strip','#seatTableSelect','#tableAlert'], ['table-status-changed'], () => { renderElapsed(); document.querySelector('#seatQueueModal button[type=submit]').disabled = !document.querySelector('#seatTableSelect input:checked'); });
        let selectedTable = {};
        let currentCustomerUrl = '';
        let lastTicketId = '';
        try { lastTicketId = sessionStorage.getItem('lastQueueTicket') || ''; } catch {}

        // Click handler on table card
        function handleTableClick(tableId, tableNo, status, sessionId, qrToken) {
            selectedTable = { tableId, tableNo, status, sessionId, qrToken };
            if (status === 'AVAILABLE') {
                document.getElementById('openTableId').value = tableId;
                document.getElementById('openTableNo').innerText = tableNo;
                resetGuestCounts('open', 0);
                document.getElementById('buffetPrice').value = 279;
                openModal('openTableModal');
            } else if (status === 'OCCUPIED') {
                document.getElementById('occTableNo').innerText = tableNo;
                document.getElementById('checkBillBtn').href = `/cashier/bill/${sessionId}`;
                openModal('occupiedTableModal');
            }
        }

        // Auto-fill guests when choosing queue in open table
        function onSelectQueueForTable(queueTicketId) {
            if (!queueTicketId) return;
            const select = document.getElementById('openQueueSelect');
            const selectedOpt = select.options[select.selectedIndex];
            const guests = selectedOpt.getAttribute('data-guests');
            if (guests) {
                resetGuestCounts('open', guests);
            }
        }

        // Submit open table form
        async function submitOpenTable(e) {
            e.preventDefault();
            const btn = e.submitter;
            if (btn.disabled) return;
            btn.disabled = true;
            const table_id = document.getElementById('openTableId').value;
            const guests = guestCounts('open');
            const buffet_price = document.getElementById('buffetPrice').value;
            const child_price = document.getElementById('openChildPrice').value;

            try {
                const res = await requestFetch('/cashier/open-table', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ table_id, ...guests, buffet_price, child_price })
                });
                const data = await res.json();
                if (data.success) {
                    closeModal('openTableModal');
                    // Populate slip details immediately
                    displaySlipData(data);
                    openModal('slipModal');
                } else {
                    alert(data.message || 'เกิดข้อผิดพลาดในการเปิดโต๊ะ');
                }
            } catch (err) {
                alert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์');
            } finally { btn.disabled = false; }
        }

        // Show slip modal for occupied table
        async function showReceiptSlipModal() {
            closeModal('occupiedTableModal');
            try {
                const res = await requestFetch(`/cashier/qr/${selectedTable.qrToken}`);
                const data = await res.json();
                if (data.success) {
                    displaySlipData(data);
                    openModal('slipModal');
                } else {
                    alert(data.message || 'ไม่สามารถโหลดข้อมูลโต๊ะได้');
                }
            } catch (err) {
                alert('ไม่สามารถโหลดข้อมูลใบเปิดโต๊ะได้');
            }
        }

        // Populate Slip Modal fields
        function displaySlipData(data) {
            document.getElementById('slipTableNo').innerText = data.table_no;
            const start = new Date(data.started_at.replace(' ','T')+'Z');
            const end = new Date(start.getTime() + 120 * 60000);
            const date = value => value.toLocaleDateString('th-TH', {timeZone:'Asia/Bangkok'});
            const time = value => value.toLocaleTimeString('th-TH', {timeZone:'Asia/Bangkok', hour:'2-digit', minute:'2-digit', hourCycle:'h23'});
            document.getElementById('slipStartedAt').innerText = date(start);
            document.getElementById('slipStartTime').innerText = time(start);
            document.getElementById('slipEndTime').innerText = time(end);
            document.getElementById('slipEndDate').innerText = date(start) === date(end) ? '' : 'หมดเวลาในวันที่ ' + date(end);
            document.getElementById('slipSessionId').innerText = data.session_id.slice(0,8).toUpperCase();
            document.getElementById('slipGuestCount').innerText = data.guest_count;
            document.getElementById('slipBuffetPrice').innerText = data.buffet_price;
            document.getElementById('slipAdultCount').innerText = data.guest_count - (data.child_count || 0) - (data.free_child_count || 0);
            document.getElementById('slipChildCount').innerText = data.child_count || 0;
            document.getElementById('slipChildPrice').innerText = data.child_price ?? 179;
            document.getElementById('slipFreeChildCount').innerText = data.free_child_count || 0;
            document.getElementById('slipChildRow').hidden = !data.child_count;
            document.getElementById('slipFreeChildRow').hidden = !data.free_child_count;
            const amount = value => Number(value).toLocaleString('th-TH', {minimumFractionDigits:2, maximumFractionDigits:2});
            document.getElementById('slipEstTotal').innerText = amount(data.buffet_totals.subtotal);
            document.getElementById('slipVat').innerText = amount(data.buffet_totals.taxAmount);
            document.getElementById('slipRounding').innerText = amount(data.buffet_totals.roundingAmount);
            document.getElementById('slipGrandTotal').innerText = amount(data.buffet_totals.netAmount);
            document.getElementById('slipQrImg').src = data.qr_image;
            document.getElementById('slipUrlText').innerText = data.customer_url;
            currentCustomerUrl = data.customer_url;
        }

        // Print Receipt Slip
        function printSlip() { printDocument(document.getElementById('slipModal').classList.contains('active') ? 'slipPrintArea' : 'queueSlipPrintArea'); }

        // Copy URL to clipboard
        function copySlipUrl() {
            if (!currentCustomerUrl) return;
            if (!navigator.clipboard) return prompt('คัดลอกลิงก์:', currentCustomerUrl);
            navigator.clipboard.writeText(currentCustomerUrl).then(() => {
                alert('คัดลอกลิงก์เรียบร้อยแล้ว: ' + currentCustomerUrl);
            }).catch(() => {
                prompt('คัดลอกลิงก์:', currentCustomerUrl);
            });
        }

        // Reset Table Status
        async function resetTableStatus() {
            const table = { ...selectedTable };
            const message = 'ยกเลิกรอบบริการที่ยังไม่มีอาหาร';
            if (!confirm('โต๊ะ ' + table.tableNo + ': ' + message + ' และเปลี่ยนเป็นว่าง?')) return;
            try {
                const res = await requestFetch('/cashier/reset-table', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ table_id: table.tableId, expected_status: table.status, expected_session_id: table.sessionId })
                });
                const data = await res.json();
                if (data.success) {
                    closeModal('occupiedTableModal');
                    refreshTables();
                } else { alert(data.message); }
            } catch (err) {
                alert('เกิดข้อผิดพลาดในการรีเซ็ตโต๊ะ');
            }
        }

        // =========================================================================
        // Queue Management Functions
        // =========================================================================
        function openQueueModal() {
            loadQueues();
            openModal('queueModal');
        }

        function openIssueQueueModal() {
            openModal('queueModal');
            document.getElementById('newQueueGuestCount').focus();
        }

        let queueTimer, queueVersion = 0;
        function loadQueues() { clearTimeout(queueTimer); queueTimer = setTimeout(loadQueueData,250); }
        async function loadQueueData() {
            const version = ++queueVersion;
            const date = document.getElementById("queueDate").value;
            const history = document.getElementById("queueHistory").checked;
            const container = document.getElementById('queueListContainer');

            try {
                const res = await requestFetch('/cashier/queue/list?' + new URLSearchParams({date,history:history ? '1' : '0'}));
                const data = await res.json();
                if (version !== queueVersion || date !== document.getElementById('queueDate').value || history !== document.getElementById('queueHistory').checked) return;
                if (data.success) {
                    document.getElementById('waitingCountDisplay').innerText = data.totalWaiting;
                    const badge = document.getElementById('queueBadge');
                    if (badge) badge.innerText = data.totalWaiting;

                    if (data.queues.length === 0) {
                        container.innerHTML = '<div class="empty" style="padding: 28px;">ยังไม่มีคิวรอ</div>';
                        return;
                    }

                    let html = '';
                    data.queues.forEach(q => {
                        const isCalled = q.queue_status === 'CALLED';
                        const actionable = q.queue_date === data.today && ['WAITING','CALLED'].includes(q.queue_status);
                        const status = {WAITING:'รอเรียก',CALLED:'เรียกแล้ว รอลูกค้ามา',SEATED:'นั่งแล้ว',CANCELLED:'ยกเลิกแล้ว'}[q.queue_status];
                        html += `
                        <div class="queue-card-item${isCalled ? ' called' : ''}">
                            <div style="display: flex; align-items: center; gap: 14px;">
                                <div class="queue-no-badge">${q.queue_no}</div>
                                <div>
                                    <div style="font-weight: 500;">${q.guest_count} ท่าน</div>
                                    <div style="font-size: 0.8rem; color: var(--ink-3);">${status}</div>
                                </div>
                            </div>
                            <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                <button class="btn btn-secondary btn-sm" onclick="reprintQueue('${q.queue_ticket_id}')">พิมพ์ซ้ำ</button>
                                ${actionable ? `<button class="btn btn-secondary btn-sm" onclick="callQueue('${q.queue_ticket_id}')">เรียกคิว</button>
                                <button class="btn btn-dark btn-sm" onclick="openSeatModal('${q.queue_ticket_id}', '${q.queue_no}', ${q.guest_count})">จัดโต๊ะ</button>
                                <button class="btn btn-ghost btn-sm" style="color: var(--danger);" onclick="cancelQueue('${q.queue_ticket_id}')">ยกเลิก</button>` : ''}
                            </div>
                        </div>
                    `;
                    });
                    container.innerHTML = html;
                } else { container.textContent = data.message; }
            } catch (err) {
                if (version !== queueVersion) return;
                container.innerHTML = '<div class="empty" style="padding: 24px; color: var(--danger);">โหลดคิวไม่สำเร็จ</div>';
            }
        }

        async function submitIssueQueue(e) {
            e.preventDefault();
            const btn = e.submitter;
            if (btn.disabled) return;
            btn.disabled = true;
            const guest_count = document.getElementById('newQueueGuestCount').value;

            try {
                const res = await requestFetch('/cashier/queue/issue', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ guest_count })
                });
                const data = await res.json();
                if (data.success) {
                    // Show Queue Ticket Slip
                    document.getElementById('qsQueueNo').innerText = data.ticket.queue_no;
                    document.getElementById('qsDate').innerText = data.ticket.queue_date;
                    document.getElementById('qsTime').innerText = data.ticket.created_at ? new Date(data.ticket.created_at.replace(' ','T')+'Z').toLocaleTimeString('th-TH',{timeZone:'Asia/Bangkok'}) : 'ไม่พบเวลาเดิม';
                    lastTicketId = data.ticket.queue_ticket_id;
                    document.getElementById('qsGuests').innerText = data.ticket.guest_count;
                    document.getElementById('qsAhead').innerText = data.ticket.count_ahead;
                    try { sessionStorage.setItem('lastQueueTicket',lastTicketId); } catch {}

                    closeModal('queueModal');
                    openModal('queueSlipModal');
                    loadQueues();
                } else {
                    alert(data.message || 'เกิดข้อผิดพลาดในการออกคิว');
                }
            } catch (err) {
                alert('เกิดข้อผิดพลาดในการออกบัตรคิว');
            } finally { btn.disabled = false; }
        }

        async function callQueue(queue_ticket_id) {
            try {
                await enableSound();
                const res = await requestFetch('/cashier/queue/call', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ queue_ticket_id })
                });
                const data = await res.json();
                if (data.success) {
                    loadQueues();
                } else { alert(data.message || 'เรียกคิวไม่สำเร็จ'); }
            } catch (err) {
                alert('เกิดข้อผิดพลาดในการเรียกคิว');
            }
        }

        function openSeatModal(queue_ticket_id, queue_no, guest_count) {
            document.getElementById('seatQueueTicketId').value = queue_ticket_id;
            document.getElementById('seatQueueNo').innerText = queue_no;
            document.getElementById('seatQueueGuests').innerText = guest_count;
            resetGuestCounts('seat', guest_count);
            document.getElementById('seatBuffetPrice').value = 279;
            closeModal('queueModal');
            openModal('seatQueueModal');
        }

        async function submitSeatQueue(e) {
            e.preventDefault();
            const btn = e.submitter;
            if (btn.disabled) return;
            btn.disabled = true;
            const queue_ticket_id = document.getElementById('seatQueueTicketId').value;
            const table_id = document.querySelector('#seatTableSelect input:checked')?.value || '';
            const buffet_price = document.getElementById('seatBuffetPrice').value;
            const child_price = document.getElementById('seatChildPrice').value;

            if (!table_id) { btn.disabled = false; alert('กรุณาเลือกโต๊ะว่าง'); return; }

            try {
                const res = await requestFetch('/cashier/queue/seat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ queue_ticket_id, table_id, ...guestCounts('seat'), buffet_price, child_price })
                });
                const data = await res.json();
                if (data.success) {
                    closeModal('seatQueueModal');
                    displaySlipData(data);
                    openModal('slipModal');
                } else {
                    alert(data.message || 'ไม่สามารถจัดคิวเข้าโต๊ะได้');
                }
            } catch (err) {
                alert('เกิดข้อผิดพลาดในการจัดคิวเข้าโต๊ะ');
            } finally { btn.disabled = false; }
        }

        async function cancelQueue(queue_ticket_id) {
            if (!confirm('ยืนยันการยกเลิกบัตรคิวนี้หรือไม่?')) return;
            try {
                const res = await requestFetch('/cashier/queue/cancel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ queue_ticket_id })
                });
                const data = await res.json();
                if (data.success) { loadQueues(); } else { alert(data.message); }
            } catch (err) {
                alert('เกิดข้อผิดพลาดในการยกเลิกคิว');
            }
        }

        async function reprintQueue(id = lastTicketId) {
            if (!id) return openQueueModal();
            try {
                const res = await requestFetch('/cashier/queue/ticket/' + encodeURIComponent(id));
                const data = await res.json();
                if (!data.success) return alert(data.message);
                const t = data.ticket;
                lastTicketId = t.queue_ticket_id;
                try { sessionStorage.setItem('lastQueueTicket',lastTicketId); } catch {}
                document.getElementById('qsQueueNo').innerText = t.queue_no;
                document.getElementById('qsDate').innerText = t.queue_date;
                document.getElementById('qsTime').innerText = t.created_at ? new Date(t.created_at.replace(' ','T')+'Z').toLocaleTimeString('th-TH',{timeZone:'Asia/Bangkok'}) : 'ไม่พบเวลาเดิม';
                document.getElementById('qsGuests').innerText = t.guest_count;
                document.getElementById('qsAhead').innerText = t.count_ahead;
                openModal('queueSlipModal');
            } catch (err) { alert('โหลดบัตรคิวไม่สำเร็จ'); }
        }
        function guestCounts(prefix) {
            return { adult_count: document.getElementById(prefix + 'AdultCount').value,
                child_count: document.getElementById(prefix + 'ChildCount').value,
                free_child_count: document.getElementById(prefix + 'FreeChildCount').value };
        }
        function updateGuestTotal(prefix) {
            document.getElementById(prefix + 'GuestTotal').textContent = Object.values(guestCounts(prefix)).reduce((sum, count) => sum + Number(count), 0);
        }
        function resetGuestCounts(prefix, adults) {
            document.getElementById(prefix + 'AdultCount').value = adults;
            document.getElementById(prefix + 'ChildCount').value = 0;
            document.getElementById(prefix + 'FreeChildCount').value = 0;
            document.getElementById(prefix + 'ChildPrice').value = 179;
            updateGuestTotal(prefix);
        }
        function stepInput(id, delta) {
            const el = document.getElementById(id);
            const next = (parseInt(el.value, 10) || 0) + delta;
            el.value = Math.min(Number(el.max || 99), Math.max(Number(el.min || 0), next));
            el.dispatchEvent(new Event('input', { bubbles: true }));
        }

        // started_at is stored as UTC by SQLite CURRENT_TIMESTAMP
        function renderElapsed() {
            document.querySelectorAll('.elapsed').forEach(el => {
                const started = new Date(el.dataset.started.replace(' ', 'T') + 'Z');
                const mins = Math.max(0, Math.floor((Date.now() - started) / 60000));
                el.textContent = mins < 60 ? `${mins} นาที`
                    : mins < 1440 ? `${Math.floor(mins / 60)}:${String(mins % 60).padStart(2, '0')} ชม.`
                    : `${Math.floor(mins / 1440)} วัน`;
            });
        }
        renderElapsed();
        setInterval(renderElapsed, 30000);

        // Modal Helpers
        function openModal(id) {
            document.querySelectorAll('.modal-overlay.active').forEach(el => dialogClose(el.id));
            dialogOpen(id);
        }
        function closeModal(id) {
            dialogClose(id);
            if (['slipModal','queueSlipModal','openTableModal','seatQueueModal'].includes(id)) {
                refreshTables();
            }
        }

        // Socket.IO Listeners
        socket.on('connect', loadQueues);
        socket.on('queue-updated', () => {
            loadQueues();
        });

        socket.on('queue-called', (data) => {
            document.getElementById('queueNotice').textContent = 'เรียกคิว ' + data.queue_no + ' แล้ว';
            announceQueue(data.queue_no);
        });
    </script>

    <%- include('../partials/footer') %>
