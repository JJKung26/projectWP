<%- include('../partials/header') %>
<div class="container" style="max-width:760px">
  <%# ปุ่มกลับผังโต๊ะและเปิดประวัติใบเสร็จ %>
  <div class="no-print page-head row between wrap">
    <a class="btn inline-row" href="/cashier/tables">กลับผังโต๊ะ</a>
    <a class="btn inline-row" href="/cashier/receipts">ใบเสร็จย้อนหลัง</a>
  </div>
  <%# ใช้ใบสรุปยอดร่วมกันทั้งก่อนและหลังชำระเงิน %>
  <%- include('../partials/receipt') %>
  <%# ยังไม่จ่ายให้รับเงิน; จ่ายแล้วให้เลือกกระดาษและพิมพ์ %>
  <div class="text-center no-print receipt-actions">
    <% if (paid) { %>
      <%- include('../partials/paper', { paperId: 'receipt-paper' }) %>
      <button class="btn btn-primary inline-row" onclick="printDocument('billPrintArea', true)">
        พิมพ์ใบเสร็จ
      </button>
    <% } else { %>
      <p>ต้องเสิร์ฟหรือยกเลิกรายการค้างก่อนรับเงิน · ปัดเศษลงหลัง VAT ทุกช่องทาง</p>
      <button class="btn btn-primary btn-block inline-row" onclick="openPayment()">
        รับชำระ <%= netAmount.toFixed(2) %> บาท
      </button>
    <% } %>
  </div>
</div>
<%# แสดงป๊อปอัปรับเงินเฉพาะบิลที่ยังไม่ชำระ %>
<% if (!paid) { %>
  <dialog class="modal-overlay row" id="paymentModal" aria-labelledby="paymentModalTitle">
    <div class="modal-content">
      <div class="modal-head row between">
        <h2 id="paymentModalTitle">รับชำระเงิน</h2>
        <button class="icon-btn plain-button center" onclick="closeModal()" aria-label="ปิด">
          ✕
        </button>
      </div>
      <form onsubmit="submitPayment(event)">
        <%# ตัวเลือกเงินสด พร้อมเพย์ และบัตรจำลอง %>
        <fieldset id="payMethod" onchange="togglePayDetails()">
          <legend class="form-label">ช่องทางชำระเงิน</legend>
          <div class="choices">
            <label>
              <input id="payCash" type="radio" name="payment_method" value="CASH" checked />
              <span><strong>เงินสด</strong> <small>รับเงินสด</small></span>
            </label>
            <label>
              <input id="payPromptpay" type="radio" name="payment_method" value="PROMPTPAY" />
              <span><strong>พร้อมเพย์</strong> <small>สแกน QR</small></span>
            </label>
            <label>
              <input id="payCard" type="radio" name="payment_method" value="CREDIT_CARD" />
              <span><strong>บัตรเครดิต</strong> <small>จำลอง</small></span>
            </label>
          </div>
        </fieldset>
        <%# QR พร้อมเพย์และยอดที่ลูกค้าต้องจ่าย %>
        <section class="text-center promptpay-panel" id="promptpayDetails" hidden>
          <div>สแกนจ่ายด้วยพร้อมเพย์</div>
          <strong class="promptpay-amount digits"><%= netAmount.toFixed(2) %> บาท</strong>
          <img class="payment-image" src="/images/promptpay.png" alt="QR พร้อมเพย์" />
          <p>กรอกยอดตามบิลในแอปธนาคาร และตรวจสอบเงินเข้าก่อนกดยืนยันรับเงิน</p>
        </section>
        <%# รูปแตะจ่าย แสดงเมื่อเลือกบัตรเครดิต %>
        <section class="text-center" id="cardNotice" hidden>
          <img class="payment-image" src="/images/card-payment.png" alt="แตะจ่ายด้วยบัตรเครดิต" />
        </section>
        <%# ช่องรับเงินสดและยอดเงินทอน %>
        <div id="cashDetails">
          <label class="form-label" for="amountReceived">รับเงิน (บาท)</label>
          <input class="form-input" id="amountReceived" type="number" min="<%= netAmount %>"
            max="1000000" step="0.01" value="0" oninput="calcChange()" required />
          <p>เงินทอน <strong id="changeAmount">0.00</strong> บาท</p>
        </div>
        <%# ปุ่มยกเลิกและยืนยันการรับเงิน %>
        <div class="flex modal-actions">
          <button type="button" class="btn inline-row" onclick="closeModal()">
            ยกเลิก
          </button>
          <button type="submit" id="confirmPayment" class="btn btn-success grow inline-row">
            ยืนยันรับเงิน
          </button>
        </div>
      </form>
    </div>
  </dialog>
  <%# ส่งยอดบิลและรอบบริการให้ payment.js %>
  <script>
    const NET = <%= netAmount %>;
    const SESSION_ID = '<%= session.session_id %>';
  </script>
  <script src="/js/payment.js"></script>
<% } %>
<%- include('../partials/footer') %>
