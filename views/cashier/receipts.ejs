<%- include('../partials/header') %>
<div class="container" style="max-width:900px">
  <%# หัวข้อประวัติใบเสร็จและปุ่มกลับผังโต๊ะ %>
  <div class="page-head row between wrap">
    <h1>ใบเสร็จย้อนหลัง</h1>
    <a class="btn inline-row" href="/cashier/tables">กลับผังโต๊ะ</a>
  </div>
  <p>200 ใบล่าสุด · อ่านข้อมูลที่บันทึก ณ เวลาชำระ</p>
  <%# แสดงยอด วันที่ และเลขใบเสร็จ กดเพื่อเปิดใบเดิม %>
  <% for (const r of receipts) { %>
    <a class="action-row row box" href="/cashier/bill/<%= r.session_id %>"
      style="overflow-wrap:anywhere">
      <span>
        <strong>โต๊ะ <%= r.table_no %> · <%= r.net_amount.toFixed(2) %> บาท</strong>
        <small><%= thaiDate(r.paid_at) %> · <%= r.receipt_no %></small>
      </span>
    </a>
  <% } %>
  <%# ข้อความเมื่อยังไม่มีประวัติรับเงิน %>
  <% if (!receipts.length) { %>
    <p>ยังไม่มีใบเสร็จ</p>
  <% } %>
</div>
<%- include('../partials/footer') %>
