<%- include('../partials/head') %>
<body class="login-page">
  <div class="login-split">
    <%# โลโก้ ชื่อร้าน และหน้าที่ของพนักงาน %>
    <aside class="login-hero row" aria-hidden="true">
      <div class="login-hero-content">
        <h1 class="login-hero-title">ร้านหมูกระทะ บุฟเฟต์</h1>
        <div class="login-hero-logo center">
          <%- include('../partials/brand-logo', { logoClass: 'hero-logo' }) %>
        </div>
        <h2 class="login-hero-tagline">ระบบจัดการร้านอาหารครบวงจร</h2>
        <p class="login-hero-sub">จัดการโต๊ะ ออเดอร์ และบิล ได้ในที่เดียว</p>
        <div class="login-hero-roles row">
          <span class="role-chip small">แคชเชียร์</span>
          <span class="role-chip small">ครัว</span>
          <span class="role-chip small">เสิร์ฟ</span>
        </div>
      </div>
    </aside>
    <%# หัวข้อเข้าสู่ระบบและข้อความเมื่อรหัสผ่านไม่ถูกต้อง %>
    <main class="login-form-panel row">
      <div class="login-form-wrap">
        <div class="login-brand row">
          <%- include('../partials/brand-logo', { logoClass: 'login-brand-logo' }) %>
          <span class="login-brand-name number">ร้านหมูกระทะ บุฟเฟต์</span>
        </div>
        <h2 class="login-heading">เข้าสู่ระบบพนักงาน</h2>
        <p class="login-sub">กรุณาเข้าสู่ระบบเพื่อดำเนินการต่อ</p>
        <% if (error) { %>
          <p class="login-error"><%= error %></p>
        <% } %>
        <%# ช่องชื่อผู้ใช้ รหัสผ่าน และปุ่มส่งไปตรวจที่ /login %>
        <form method="POST" action="/login" class="login-form">
          <div class="form-group">
            <label class="form-label" for="username">ชื่อผู้ใช้</label>
            <div class="input-icon-wrap row">
              <img class="input-icon" src="/images/icons/user.svg" width="18" height="18" alt="" />
              <input class="form-input" type="text" id="username" name="username"
                value="<%= username %>" placeholder="กรอกชื่อผู้ใช้ของคุณ" required autofocus
                autocomplete="username" />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="password">รหัสผ่าน</label>
            <div class="input-icon-wrap row">
              <img class="input-icon" src="/images/icons/lock.svg" width="18" height="18" alt="" />
              <input class="form-input" type="password" id="password" name="password"
                placeholder="กรอกรหัสผ่านของคุณ" required autocomplete="current-password" />
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-block btn-lg inline-row">
            เข้าสู่ระบบ
          </button>
        </form>
      </div>
    </main>
  </div>
  <%- include('../partials/footer') %>
