<%- include('../partials/header') %>
<%
    // SQLite CURRENT_TIMESTAMP is UTC without a zone marker
    const toTime = s => new Date(String(s).replace(' ', 'T') + 'Z')
        .toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Bangkok' });
%>

<div class="container">
    <div class="page-head">
        <div>
            <div class="eyebrow">เสิร์ฟ</div>
            <h1>รอนำไปเสิร์ฟ</h1>
            <p>ครัวทำเสร็จแล้ว ยกไปที่โต๊ะแล้วกดยืนยัน</p>
        </div>
        <div class="stat-strip">
            <div class="stat">
                <div class="stat-label"><span class="dot ok"></span>พร้อมเสิร์ฟ</div>
                <div class="stat-value"><%= readyItems.length %></div>
            </div>
        </div>
    </div>

    <% if (readyItems.length === 0) { %>
        <div class="card empty">
            <div class="empty-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"/></svg>
            </div>
            <h3>ไม่มีจานค้างเสิร์ฟ</h3>
            <p>เมื่อครัวกด "เสร็จแล้ว" รายการจะขึ้นที่นี่ทันที</p>
        </div>
    <% } else { %>
        <div class="ticket-grid">
            <% readyItems.forEach(item => { %>
                <div class="ticket is-ready">
                    <div class="ticket-head">
                        <span class="ticket-table">โต๊ะ <%= item.table_no %></span>
                        <span class="ticket-time">สั่ง <%= toTime(item.ordered_at) %></span>
                    </div>
                    <div class="ticket-body">
                        <img class="ticket-thumb" src="<%= item.image_url %>" alt="" onerror="this.style.visibility='hidden'">
                        <div class="ticket-item"><%= item.item_name %></div>
                        <div class="ticket-qty"><small>×</small><%= item.quantity %></div>
                    </div>
                    <div class="ticket-actions">
                        <button class="btn btn-dark" onclick="confirmServed('<%= item.order_item_id %>')">เสิร์ฟแล้ว</button>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<script>
    const socket = io();

    async function confirmServed(order_item_id) {
        try {
            const res = await fetch('/serving/confirm-served', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ order_item_id })
            });
            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'เกิดข้อผิดพลาดในการยืนยันเสิร์ฟ');
            }
        } catch (err) {
            alert('เกิดข้อผิดพลาดในการยืนยันเสิร์ฟ');
        }
    }

    socket.on('order-status-changed', () => location.reload());
    socket.on('new-order', () => location.reload());
</script>

<%- include('../partials/footer') %>
