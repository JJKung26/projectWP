<%- include('../partials/header') %>
<div class="container serving-page">
  <%# หัวข้อจุดเสิร์ฟและจำนวนรายการที่ครัวทำเสร็จ %>
  <div class="page-head row between wrap">
    <div>
      <div class="small muted">เสิร์ฟ</div>
      <h1>รอนำไปเสิร์ฟ</h1>
      <p>ครัวทำเสร็จแล้ว ยกไปที่โต๊ะแล้วกดยืนยัน</p>
    </div>
    <div class="flex stat-strip box">
      <div class="stat">
        <div class="stat-label row small muted">
          <span class="dot ok"></span>
          พร้อมเสิร์ฟ
        </div>
        <div class="stat-value number digits large"><%= readyItems.length %></div>
      </div>
    </div>
  </div>
  <%# แสดงรอบพร้อมเสิร์ฟ หรือข้อความเมื่อไม่มีรายการ %>
  <% if (readyRounds.length === 0) { %>
    <%- include('../partials/empty', {
      heading: 'ไม่มีจานค้างเสิร์ฟ', message: 'เมื่อครัวกด "เสร็จแล้ว" รายการจะขึ้นที่นี่ทันที'
    }) %>
  <% } else { %>
    <div class="round-card-list column">
      <% for (const round of readyRounds) { %>
        <%- include('../partials/staff-order-card', { round, mode: 'serving' }) %>
      <% } %>
    </div>
  <% } %>
</div>
<%# โหลดคำสั่งยืนยันเสิร์ฟและอัปเดตรายการ %>
<script src="/js/serving.js"></script>
<%- include('../partials/footer') %>
