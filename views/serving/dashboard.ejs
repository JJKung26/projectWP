<%- include('../partials/header') %>
<div class="container">
    <div class="page-head">
        <div> <div class="eyebrow">เสิร์ฟ</div> <h1>รอนำไปเสิร์ฟ</h1> <p>ครัวทำเสร็จแล้ว ยกไปที่โต๊ะแล้วกดยืนยัน</p> </div>
        <div class="stat-strip">
            <div class="stat"> <div class="stat-label"><span class="dot ok"></span>พร้อมเสิร์ฟ</div> <div class="stat-value"><%= readyItems.length %></div> </div>
        </div>
    </div>
    <% if (!readyRounds || readyRounds.length === 0) { %>
        <div class="card empty">
            <div class="empty-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"/></svg>
            </div>
            <h3>ไม่มีจานค้างเสิร์ฟ</h3>
            <p>เมื่อครัวกด "เสร็จแล้ว" รายการจะขึ้นที่นี่ทันที</p>
        </div>
    <% } else { %>
        <div class="round-card-list">
            <% for (const round of readyRounds) { %>
                <%- include('../partials/staff-order-card', { round, mode: 'serving' }) %>
            <% } %>
        </div>
    <% } %>
</div>
<script src="/js/serving.js?v=basic-1"></script>
<%- include('../partials/footer') %>
